  "documentation": [
    {
      "id": "DEC-TEMPORAL-PATTERN",
      "title": "Bitemporal business history",
      "module": "domain",
      "context": "ITSD reference brief, section 3b",
      "alternatives": "See the corresponding advocated standard and the reference brief.",
      "rationale": "Ticket, Agent and Customer corrections must preserve both effective and as-known history; Category is current-state.",
      "consequences": "Preserve this decision in deployment and disclose unverified capabilities.",
      "category": "ARCHITECTURE",
      "source": "ITSD_Reference_Brief.md#3b"
    },
    {
      "id": "DEC-COLUMN-STRATEGY",
      "title": "Offload operational evidence",
      "module": "domain",
      "context": "ITSD reference brief, section 3b",
      "alternatives": "See the corresponding advocated standard and the reference brief.",
      "rationale": "Operational lineage and quality live in Observability; canonical temporal/audit fields follow the design pattern.",
      "consequences": "Preserve this decision in deployment and disclose unverified capabilities.",
      "category": "ARCHITECTURE",
      "source": "ITSD_Reference_Brief.md#3b"
    },
    {
      "id": "DEC-SURROGATE-ALLOCATION",
      "title": "Stable keymaps",
      "module": "domain",
      "context": "ITSD reference brief, section 3b",
      "alternatives": "See the corresponding advocated standard and the reference brief.",
      "rationale": "Ticket, Agent and Customer use permanent keymaps; Category is an inline current-state reference.",
      "consequences": "Preserve this decision in deployment and disclose unverified capabilities.",
      "category": "ARCHITECTURE",
      "source": "ITSD_Reference_Brief.md#3b"
    },
    {
      "id": "DEC-DELETE-STRATEGY",
      "title": "Soft deletion",
      "module": "domain",
      "context": "ITSD reference brief, section 3b",
      "alternatives": "See the corresponding advocated standard and the reference brief.",
      "rationale": "Deletion retains a tombstone and prior effective and knowledge-time history.",
      "consequences": "Preserve this decision in deployment and disclose unverified capabilities.",
      "category": "ARCHITECTURE",
      "source": "ITSD_Reference_Brief.md#3b"
    },
    {
      "id": "DEC-TIMESTAMP-ZONE",
      "title": "UTC instants",
      "module": "domain",
      "context": "ITSD reference brief, section 3b",
      "alternatives": "See the corresponding advocated standard and the reference brief.",
      "rationale": "Source timestamps are UTC; timezone-aware instants preserve ordering.",
      "consequences": "Preserve this decision in deployment and disclose unverified capabilities.",
      "category": "ARCHITECTURE",
      "source": "ITSD_Reference_Brief.md#3b"
    },
    {
      "id": "DEC-QUALITY-STORAGE",
      "title": "Separate quality evidence",
      "module": "observability",
      "context": "ITSD reference brief, section 3b",
      "alternatives": "See the corresponding advocated standard and the reference brief.",
      "rationale": "Quality assessments are separate time-series records in Observability.",
