      "category": "ARCHITECTURE",
      "source": "ITSD_Reference_Brief.md#3b"
    },
    {
      "id": "DEC-AUDIT-RETENTION",
      "title": "Bounded three-year retention",
      "module": "observability",
      "context": "ITSD reference brief, section 3b",
      "alternatives": "See the corresponding advocated standard and the reference brief.",
      "rationale": "No statutory retention obligation; three years covers operational investigation. Revisit if scope changes.",
      "consequences": "Preserve this decision in deployment and disclose unverified capabilities.",
      "category": "ARCHITECTURE",
      "source": "ITSD_Reference_Brief.md#3b"
