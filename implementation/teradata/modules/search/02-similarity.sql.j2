{# One similarity procedure per `Embedding:` block the build context gives a `procedure`
   object (Search). Vectors are little-endian 8-byte floats in VARBYTE, which TD_VECTORDISTANCE
   reads directly; they come from the declared encoder, and this binding never substitutes one.

   TD_VECTORDISTANCE is a table operator: it cannot sit in a view or a SQL function, and it
   takes no bind or macro parameter inside its ON clauses. So the procedure writes the query
   vector into the request as a hex literal (left-padded, since FROM_BYTES drops leading zero
   digits) and runs it as dynamic SQL, returning one result set of (entity_id, similarity):
   the current vectors of its block, ranked by the declared similarity, at or above the
   declared threshold, at most `result_limit` (clamped to 0..1000) of them. A query vector of
   the wrong length, or a limit of zero, returns no rows. Scores match every binding's:
   cosine and dot are 1 - distance (TD_VECTORDISTANCE's distances are 1 - cosine and
   1 - dot), euclidean and manhattan 1 / (1 + distance).

   A database's creator is not granted CREATE PROCEDURE on it, so where the profile names the
   `Deploying user`, that user is granted it on each database that holds a procedure. #}
{% import 'patterns/temporal-lifecycle-metadata/00-macros.sql.j2' as m with context %}
{#- A text literal written inside the dynamic SQL's own literal: its quotes doubled twice. -#}
{% macro inner(text) -%}{{ (text|literal)|replace("'", "''") }}{%- endmacro %}
{% set measures = {'cosine': 'cosine', 'dot': 'dotproduct', 'euclidean': 'euclidean', 'manhattan': 'manhattan'} %}
{% set procedures = embeddings|selectattr('objects.procedure', 'defined')|list %}
{% if procedures and settings['deploying_user'] != 'none' %}
{% for container in procedures|map(attribute='objects.procedure.container')|unique %}
GRANT CREATE PROCEDURE ON {{ container|ident }} TO {{ settings['deploying_user']|ident }};
{%- endfor %}
{% endif %}
{% for b in procedures %}
{% set store = named(b.store) %}{% set sc = store.column_names %}
{% set vector = store.columns|selectattr('physical_name', 'equalto', b.vector_column)|first %}
{% set width = b.dimensions|int * 8 %}
{% set score = "1 - d.distance" if b.similarity in ('cosine', 'dot') else "1 / (1 + d.distance)" %}
REPLACE PROCEDURE {{ b.objects.procedure|qualified }} (IN query_vector {{ vector.physical_type }}, IN result_limit INTEGER)
DYNAMIC RESULT SETS 1
BEGIN
    DECLARE query_text VARCHAR({{ 2 * width + 4000 }});
    DECLARE top_n INTEGER DEFAULT 0;
    DECLARE results CURSOR WITH RETURN ONLY FOR prepared_query;
    IF result_limit > 1000 THEN SET top_n = 1000;
    ELSEIF result_limit > 0 THEN SET top_n = result_limit;
    END IF;
    IF query_vector IS NULL OR BYTES(query_vector) <> {{ width }} OR top_n = 0 THEN
        SET query_text = 'SELECT CAST(NULL AS BIGINT) AS entity_id, CAST(NULL AS FLOAT) AS similarity FROM DBC.DBCInfoV WHERE 1 = 0';
    ELSE
        SET query_text = 'SELECT d.target_id AS entity_id, CAST({{ score }} AS FLOAT) AS similarity FROM TD_VECTORDISTANCE('
            || 'ON (SELECT e.{{ sc.entity_id|ident }} AS entity_id, e.{{ b.vector_column|ident }} AS embedding FROM {{ store.objects.consumer_view|qualified }} e '
            || 'WHERE e.{{ sc.source_attribute|ident }} = {{ inner(b.name) }}'
{%- if b.model is defined and b.model %}
            || ' AND e.{{ sc.embedding_model|ident }} = {{ inner(b.model) }}'
{%- endif %}
            || ') AS TargetTable PARTITION BY ANY '
            || 'ON (SELECT CAST(0 AS BIGINT) AS query_id, CAST(''' || LPAD(CAST(FROM_BYTES(query_vector, 'base16') AS VARCHAR({{ 2 * width }})), {{ 2 * width }}, '0')
            || '''XB AS {{ vector.physical_type }}) AS embedding) AS ReferenceTable DIMENSION '
            || 'USING TargetIDColumn(''entity_id'') TargetFeatureColumns(''embedding'') RefIDColumn(''query_id'') RefFeatureColumns(''embedding'') '
            || 'DistanceMeasure(''{{ measures[b.similarity] }}'') TopK(1)) AS d'
{%- if b.threshold is defined and b.threshold %}
            || ' WHERE {{ score }} >= {{ b.threshold }}'
{%- endif %}
            || ' QUALIFY ROW_NUMBER() OVER (ORDER BY {{ score }} DESC, d.target_id) <= ' || TRIM(top_n)
            || ' ORDER BY similarity DESC, entity_id';
    END IF;
    PREPARE prepared_query FROM query_text;
    OPEN results;
END;
COMMENT ON PROCEDURE {{ b.objects.procedure|qualified }} IS {{ m.comment('Similarity search over the ' ~ b.name ~ ' embedding of ' ~ b.entity ~ '. Takes a query vector and a result limit (maximum 1000); returns entity_id and similarity.') }};
{% endfor %}
