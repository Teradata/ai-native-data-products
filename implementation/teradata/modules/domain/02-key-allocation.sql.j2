{# Caller-rendered, with keymap (a Keymap entity from the build context) and either:
   - natural_value, one value: the MERGE inserts it if new, the SELECT returns its identifier; or
   - staged, a set of values the caller has written to a table: {container (null for a
     session-local table), name, column}. One MERGE inserts every new value, NULLs and
     duplicates ignored, and the SELECT returns each staged value with its identifier.
   The caller runs both statements in one transaction. Allocation is permanent: a keymap row
   is never deleted or recycled. The merge matches on the keymap's primary index, its
   natural key, as Teradata requires. #}
{% set natural = keymap.identity.natural[0] %}{% set n = keymap.column_names[natural] %}
{% set natural_type = (keymap.columns|selectattr('physical_name', 'equalto', n)|first).physical_type %}
{% if staged is defined %}{% set source = staged|qualified if staged.container else staged.name|ident %}{% set v = staged.column|ident %}
MERGE INTO {{ keymap.objects.table|qualified }} AS k
USING (SELECT DISTINCT CAST(s.{{ v }} AS {{ natural_type }}) AS natural_value FROM {{ source }} AS s WHERE s.{{ v }} IS NOT NULL) AS s
ON k.{{ n|ident }} = s.natural_value
WHEN NOT MATCHED THEN INSERT ({{ n|ident }}, {{ keymap.column_names.created_dts|ident }}, {{ keymap.column_names.updated_dts|ident }})
VALUES (s.natural_value, CURRENT_TIMESTAMP(6), CURRENT_TIMESTAMP(6));
SELECT k.{{ n|ident }}, k.{{ keymap.key_columns[0]|ident }} FROM {{ keymap.objects.table|qualified }} AS k WHERE k.{{ n|ident }} IN (SELECT s.{{ v }} FROM {{ source }} AS s);
{% else %}
MERGE INTO {{ keymap.objects.table|qualified }} AS k
USING (SELECT CAST({{ natural_value|literal }} AS {{ natural_type }}) AS natural_value) AS s
ON k.{{ n|ident }} = s.natural_value
WHEN NOT MATCHED THEN INSERT ({{ n|ident }}, {{ keymap.column_names.created_dts|ident }}, {{ keymap.column_names.updated_dts|ident }})
VALUES (s.natural_value, CURRENT_TIMESTAMP(6), CURRENT_TIMESTAMP(6));
SELECT {{ keymap.key_columns[0]|ident }} FROM {{ keymap.objects.table|qualified }} WHERE {{ n|ident }} = {{ natural_value|literal }};
{% endif %}
