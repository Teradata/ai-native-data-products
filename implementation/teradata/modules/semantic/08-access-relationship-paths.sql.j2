-- Semantic module: access-resolved relationship paths (Teradata). Binding of design/modules/semantic.md §5.
-- relationship_paths stays the logical, entity-level truth. This view keeps its rows and adds,
-- for each step, the agent-consumable access_object that exposes the step's from and to entity,
-- as the verbatim container.object, so an agent receives joins against objects it can query.
-- A path with any entity on it that has no consumable object is dropped whole, never emitted
-- against a base table. Replace {{ product }}.

REPLACE VIEW {{ product }}_Semantic.access_relationship_paths
(
      path_id, origin_entity, destination_entity, hop_count
    , hop, key_ordinal
    , from_entity, from_object, from_column
    , to_entity, to_object, to_column
    , relationship_id, direction
)
AS
LOCKING ROW FOR ACCESS
SELECT
      pth.path_id
    , pth.origin_entity
    , pth.destination_entity
    , pth.hop_count
    , pth.hop
    , pth.key_ordinal
    , pth.from_entity
    , fao.database_name || '.' || fao.object_name
    , pth.from_column
    , pth.to_entity
    , tao.database_name || '.' || tao.object_name
    , pth.to_column
    , pth.relationship_id
    , pth.direction
FROM {{ product }}_Semantic.relationship_paths AS pth
INNER JOIN {{ product }}_Semantic.access_object AS fao
    ON  fao.represents_entity  = pth.from_entity
    AND fao.is_agent_consumable = 1
    AND fao.is_active           = 1
INNER JOIN {{ product }}_Semantic.access_object AS tao
    ON  tao.represents_entity  = pth.to_entity
    AND tao.is_agent_consumable = 1
    AND tao.is_active           = 1
WHERE NOT EXISTS (
    SELECT 1
    FROM {{ product }}_Semantic.relationship_paths AS stp
    WHERE stp.path_id = pth.path_id
      AND (   NOT EXISTS (
                  SELECT 1 FROM {{ product }}_Semantic.access_object AS xfo
                  WHERE xfo.represents_entity   = stp.from_entity
                    AND xfo.is_agent_consumable = 1
                    AND xfo.is_active           = 1)
           OR NOT EXISTS (
                  SELECT 1 FROM {{ product }}_Semantic.access_object AS xto
                  WHERE xto.represents_entity   = stp.to_entity
                    AND xto.is_agent_consumable = 1
                    AND xto.is_active           = 1)));

COMMENT ON VIEW {{ product }}_Semantic.access_relationship_paths IS
'Access-resolved relationship paths - relationship_paths rows with each step endpoint resolved to its agent-consumable object. A path with any entity lacking a consumable object is omitted whole.';
COMMENT ON COLUMN {{ product }}_Semantic.access_relationship_paths.path_id IS 'The ordered legs of the path - relationship id then > (FORWARD) or < (REVERSE).';
COMMENT ON COLUMN {{ product }}_Semantic.access_relationship_paths.origin_entity IS 'Entity the whole path starts from - the logical identity.';
COMMENT ON COLUMN {{ product }}_Semantic.access_relationship_paths.destination_entity IS 'Entity the whole path ends at - the logical identity.';
COMMENT ON COLUMN {{ product }}_Semantic.access_relationship_paths.hop_count IS 'Number of steps in the path, 1 to 4.';
COMMENT ON COLUMN {{ product }}_Semantic.access_relationship_paths.hop IS 'Position of this step in the path, from 1.';
COMMENT ON COLUMN {{ product }}_Semantic.access_relationship_paths.key_ordinal IS 'Position of the column pair within the relationship join group, from 1.';
COMMENT ON COLUMN {{ product }}_Semantic.access_relationship_paths.from_entity IS 'Entity this step leaves.';
COMMENT ON COLUMN {{ product }}_Semantic.access_relationship_paths.from_object IS 'Consumable object exposing from_entity, as container.object, used verbatim.';
COMMENT ON COLUMN {{ product }}_Semantic.access_relationship_paths.from_column IS 'Column on from_entity in this join pair.';
COMMENT ON COLUMN {{ product }}_Semantic.access_relationship_paths.to_entity IS 'Entity this step reaches.';
COMMENT ON COLUMN {{ product }}_Semantic.access_relationship_paths.to_object IS 'Consumable object exposing to_entity, as container.object, used verbatim.';
COMMENT ON COLUMN {{ product }}_Semantic.access_relationship_paths.to_column IS 'Column on to_entity in this join pair.';
COMMENT ON COLUMN {{ product }}_Semantic.access_relationship_paths.relationship_id IS 'Relationship this step traverses - table_relationship.relationship_id.';
COMMENT ON COLUMN {{ product }}_Semantic.access_relationship_paths.direction IS 'FORWARD crosses the relationship source to target, REVERSE target to source.';
