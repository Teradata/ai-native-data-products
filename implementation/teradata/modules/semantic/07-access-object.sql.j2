-- Semantic module: access-object layer (Teradata). Binding of design/modules/semantic.md §3.3.
-- Registers the objects a consumer actually queries (access_object), what a COMPOSITE object
-- encapsulates (access_composition), and where each output column of an object comes from
-- (access_column), so a consumer resolves any queryable object to its logical meaning once,
-- from metadata, instead of reverse-engineering it from names or definitions.
-- Access-layer metadata (which objects represent what), distinct from the security access-layer
-- pattern (who may read them). Replace {{ product }}.
--
-- An object is identified logically (object_identity: module.entity:surface, module:object or
-- composite:name) and located physically (database_name, object_name). The identity never
-- changes when a container is renamed or the design is deployed with a different placement.
{%- import 'patterns/temporal-lifecycle-metadata/00-temporal-macros.sql.j2' as tlm %}

-- access_object: registry of consumable objects -------------------------------
CREATE TABLE {{ product }}_Semantic.access_object (
    access_object_id INTEGER NOT NULL GENERATED ALWAYS AS IDENTITY,
    object_identity VARCHAR(200) NOT NULL,  -- logical identity; unique among active rows
    database_name VARCHAR(128) NOT NULL,
    object_name VARCHAR(128) NOT NULL,
    access_role VARCHAR(40) NOT NULL,       -- BASE, PASSTHROUGH, COMPOSITE, or an extension value
    represents_entity VARCHAR(200),         -- entity_metadata.entity_name; null for cross-entity composites
    object_grain VARCHAR(200),
    is_agent_consumable BYTEINT NOT NULL DEFAULT 1,
    resolves_to_object VARCHAR(200),        -- object_identity of the object a 1:1 passthrough maps to
    access_note VARCHAR(500),
    is_active BYTEINT NOT NULL DEFAULT 1,
{{ tlm.columns('CURRENT_STATE', pad=8) }}
)
PRIMARY INDEX (object_identity);

COMMENT ON TABLE {{ product }}_Semantic.access_object IS
'Registry of consumable objects - which object a consumer queries, what it represents, its grain, and whether an agent should query it directly. Access-layer metadata, not security.';
COMMENT ON COLUMN {{ product }}_Semantic.access_object.object_identity IS 'Logical identity - module.entity:surface, module:object or composite:name. Placement-independent; the location is database_name and object_name.';
COMMENT ON COLUMN {{ product }}_Semantic.access_object.database_name IS 'Container the object is deployed in.';
COMMENT ON COLUMN {{ product }}_Semantic.access_object.object_name IS 'The queryable object (table or view).';
COMMENT ON COLUMN {{ product }}_Semantic.access_object.access_role IS 'Role in the access layer - open vocabulary; baseline BASE, PASSTHROUGH, COMPOSITE; extensions add.';
COMMENT ON COLUMN {{ product }}_Semantic.access_object.represents_entity IS 'Entity this object exposes (entity_metadata.entity_name, the logical identity); null for composites spanning entities.';
COMMENT ON COLUMN {{ product }}_Semantic.access_object.object_grain IS 'Plain-language grain - one row per call.';
COMMENT ON COLUMN {{ product }}_Semantic.access_object.is_agent_consumable IS '1 = agents/humans should query this object directly, 0 = internal.';
COMMENT ON COLUMN {{ product }}_Semantic.access_object.resolves_to_object IS 'For 1:1 passthroughs, the object_identity this maps straight through to (collapse to the entity in one hop).';
COMMENT ON COLUMN {{ product }}_Semantic.access_object.access_note IS 'Free-form guidance - locking, filtering.';
COMMENT ON COLUMN {{ product }}_Semantic.access_object.is_active IS '1 = active, 0 = deprecated.';
{{ tlm.comments(product ~ '_Semantic.access_object', 'CURRENT_STATE') }}

-- access_composition: what a COMPOSITE object encapsulates --------------------
-- Each non-anchor member joins to a prior member through one relationship, crossed in the
-- stated direction; the column pairs are the rows of relationship_column.
CREATE TABLE {{ product }}_Semantic.access_composition (
    access_composition_id INTEGER NOT NULL GENERATED ALWAYS AS IDENTITY,
    composite_object VARCHAR(200) NOT NULL, -- access_object.object_identity of the composite
    member_seq SMALLINT NOT NULL CHECK (member_seq >= 1),
    member_entity VARCHAR(200) NOT NULL,    -- entity_metadata.entity_name
    member_role VARCHAR(20) NOT NULL,       -- ANCHOR, INNER, LEFT, RIGHT, FULL
    via_relationship_id INTEGER,            -- table_relationship.relationship_id; null for the ANCHOR
    via_direction VARCHAR(7) CHECK (via_direction IN ('FORWARD', 'REVERSE')),
    is_grain_contributor BYTEINT NOT NULL DEFAULT 0,
    member_note VARCHAR(500),
    is_active BYTEINT NOT NULL DEFAULT 1,
{{ tlm.columns('CURRENT_STATE', pad=8) }}
)
PRIMARY INDEX (composite_object);

COMMENT ON TABLE {{ product }}_Semantic.access_composition IS
'Members of a COMPOSITE access object, one row per member, referenced as entities - so a consumer expands the composite from metadata, never from its definition.';
COMMENT ON COLUMN {{ product }}_Semantic.access_composition.composite_object IS 'Logical identity of the composite being described - access_object.object_identity, composite:name.';
COMMENT ON COLUMN {{ product }}_Semantic.access_composition.member_seq IS 'Ordering of the member within the composite, from 1 without gaps; the ANCHOR is 1.';
COMMENT ON COLUMN {{ product }}_Semantic.access_composition.member_entity IS 'Entity the member represents (entity_metadata.entity_name).';
COMMENT ON COLUMN {{ product }}_Semantic.access_composition.member_role IS 'Join role - ANCHOR, INNER, LEFT, RIGHT, FULL.';
COMMENT ON COLUMN {{ product }}_Semantic.access_composition.via_relationship_id IS 'Relationship that joins this member to a prior member (table_relationship.relationship_id); null for the ANCHOR.';
COMMENT ON COLUMN {{ product }}_Semantic.access_composition.via_direction IS 'FORWARD when the prior member is the relationship source and this member its target, REVERSE when the prior member is the target.';
COMMENT ON COLUMN {{ product }}_Semantic.access_composition.is_grain_contributor IS '1 = this member changes the composite grain, 0 = does not.';
COMMENT ON COLUMN {{ product }}_Semantic.access_composition.member_note IS 'Free-form guidance.';
COMMENT ON COLUMN {{ product }}_Semantic.access_composition.is_active IS '1 = active, 0 = deprecated.';
{{ tlm.comments(product ~ '_Semantic.access_composition', 'CURRENT_STATE') }}

-- access_column: where each output column of an access object comes from --------
-- One row per output column of every agent-consumable object (INV-SEMANTIC-019).
CREATE TABLE {{ product }}_Semantic.access_column (
    access_column_id VARCHAR(220) NOT NULL, -- object_identity:ordinal
    object_identity VARCHAR(200) NOT NULL,  -- access_object.object_identity
    ordinal SMALLINT NOT NULL CHECK (ordinal >= 1),
    column_name VARCHAR(128) NOT NULL,      -- output column name on the access object
    source_entity VARCHAR(200),             -- entity the value comes from; null when DERIVED
    source_column VARCHAR(128),             -- column on source_entity; null when DERIVED
    mapping_kind VARCHAR(11) NOT NULL CHECK (mapping_kind IN ('PASSTHROUGH', 'RENAMED', 'DERIVED')),
    derivation_note VARCHAR(500),           -- how a DERIVED column is computed
    is_active BYTEINT NOT NULL DEFAULT 1 CHECK (is_active IN (0, 1)),
{{ tlm.columns('CURRENT_STATE', pad=8) }}
)
PRIMARY INDEX (object_identity);

COMMENT ON TABLE {{ product }}_Semantic.access_column IS
'Column mapping of access objects - one row per output column giving its source entity and column, so a consumer traces a value without reading a view definition.';
COMMENT ON COLUMN {{ product }}_Semantic.access_column.access_column_id IS 'Key of the row: object_identity, a colon, then ordinal.';
COMMENT ON COLUMN {{ product }}_Semantic.access_column.object_identity IS 'Access object the column belongs to - access_object.object_identity (validated by the module checks, no physical constraint).';
COMMENT ON COLUMN {{ product }}_Semantic.access_column.ordinal IS 'Position of the column in the object, from 1.';
COMMENT ON COLUMN {{ product }}_Semantic.access_column.column_name IS 'Name of the output column on the access object.';
COMMENT ON COLUMN {{ product }}_Semantic.access_column.source_entity IS 'Entity (logical identity) the value is taken from; null for a DERIVED column.';
COMMENT ON COLUMN {{ product }}_Semantic.access_column.source_column IS 'Column on source_entity the value is taken from; null for a DERIVED column.';
COMMENT ON COLUMN {{ product }}_Semantic.access_column.mapping_kind IS 'PASSTHROUGH = same name as the source, RENAMED = same value under a new name, DERIVED = computed.';
COMMENT ON COLUMN {{ product }}_Semantic.access_column.derivation_note IS 'How a DERIVED column is computed, in plain language; null otherwise.';
COMMENT ON COLUMN {{ product }}_Semantic.access_column.is_active IS '1 = current, 0 = withdrawn.';
{{ tlm.comments(product ~ '_Semantic.access_column', 'CURRENT_STATE') }}
