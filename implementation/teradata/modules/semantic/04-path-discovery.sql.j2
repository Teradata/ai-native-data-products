-- Semantic module: relationship edges and multi-hop path discovery (Teradata).
-- Binding of design/modules/semantic.md, section 5. Replace {{ product }}.
--
-- relationship_edges is one row per direction per key position of every active relationship.
-- relationship_paths walks those relationships in either direction, bounded to 4 hops and
-- never revisiting an entity, and returns each path as rows: one per hop per key position.
-- An agent assembles the JOIN from the rows; the view builds no SQL text.
--
-- path_id is the ordered legs of the path, each a relationship_id followed by '>' (FORWARD,
-- source to target) or '<' (REVERSE, target to source) - 12>7< is relationship 12 forward,
-- then relationship 7 in reverse.

-- relationship_edges: every relationship pair, once per direction -------------
REPLACE VIEW {{ product }}_Semantic.relationship_edges
(
      relationship_id, key_ordinal, direction
    , from_entity, from_column, to_entity, to_column
)
AS
LOCKING ROW FOR ACCESS
SELECT
      rel.relationship_id
    , CAST(rcl.ordinal AS INTEGER)
    , CAST('FORWARD' AS VARCHAR(7))
    , rel.source_entity
    , rcl.source_column
    , rel.target_entity
    , rcl.target_column
FROM {{ product }}_Semantic.table_relationship AS rel
INNER JOIN {{ product }}_Semantic.relationship_column AS rcl
    ON  rcl.relationship_id = rel.relationship_id
    AND rcl.is_active       = 1
WHERE rel.is_active = 1
UNION ALL
SELECT
      rel.relationship_id
    , CAST(rcl.ordinal AS INTEGER)
    , CAST('REVERSE' AS VARCHAR(7))
    , rel.target_entity
    , rcl.target_column
    , rel.source_entity
    , rcl.source_column
FROM {{ product }}_Semantic.table_relationship AS rel
INNER JOIN {{ product }}_Semantic.relationship_column AS rcl
    ON  rcl.relationship_id = rel.relationship_id
    AND rcl.is_active       = 1
WHERE rel.is_active = 1;

COMMENT ON VIEW {{ product }}_Semantic.relationship_edges IS
'Relationship edges - one row per active relationship per direction per key position, giving the entity and column each side of the join. The building block of relationship_paths.';
COMMENT ON COLUMN {{ product }}_Semantic.relationship_edges.relationship_id IS 'Relationship the edge belongs to - table_relationship.relationship_id.';
COMMENT ON COLUMN {{ product }}_Semantic.relationship_edges.key_ordinal IS 'Position of the column pair within the relationship join group, from 1.';
COMMENT ON COLUMN {{ product }}_Semantic.relationship_edges.direction IS 'FORWARD crosses source to target, REVERSE crosses target to source.';
COMMENT ON COLUMN {{ product }}_Semantic.relationship_edges.from_entity IS 'Entity the edge leaves - the logical identity.';
COMMENT ON COLUMN {{ product }}_Semantic.relationship_edges.from_column IS 'Column on from_entity in this join pair.';
COMMENT ON COLUMN {{ product }}_Semantic.relationship_edges.to_entity IS 'Entity the edge reaches - the logical identity.';
COMMENT ON COLUMN {{ product }}_Semantic.relationship_edges.to_column IS 'Column on to_entity in this join pair.';

-- relationship_paths: bounded, cycle-free paths as rows -----------------------
REPLACE VIEW {{ product }}_Semantic.relationship_paths
(
      path_id, origin_entity, destination_entity, hop_count
    , hop, key_ordinal
    , from_entity, from_column, to_entity, to_column
    , relationship_id, direction
)
AS
WITH RECURSIVE walked
    (path_id, origin_entity, destination_entity, hop_count, visited_entities) AS (
    -- Anchor: forward, one hop
    SELECT CAST(TRIM(rel.relationship_id) || '>' AS VARCHAR(200))
         , rel.source_entity
         , rel.target_entity
         , CAST(1 AS INTEGER)
         , CAST('|' || rel.source_entity || '|' || rel.target_entity || '|' AS VARCHAR(1100))
    FROM {{ product }}_Semantic.table_relationship AS rel
    WHERE rel.is_active = 1
      AND rel.source_entity <> rel.target_entity

    UNION ALL
    -- Anchor: reverse, one hop
    SELECT CAST(TRIM(rel.relationship_id) || '<' AS VARCHAR(200))
         , rel.target_entity
         , rel.source_entity
         , CAST(1 AS INTEGER)
         , CAST('|' || rel.target_entity || '|' || rel.source_entity || '|' AS VARCHAR(1100))
    FROM {{ product }}_Semantic.table_relationship AS rel
    WHERE rel.is_active = 1
      AND rel.source_entity <> rel.target_entity

    UNION ALL
    -- Recursive: forward
    SELECT CAST(wlk.path_id || TRIM(rel.relationship_id) || '>' AS VARCHAR(200))
         , wlk.origin_entity
         , rel.target_entity
         , wlk.hop_count + 1
         , CAST(wlk.visited_entities || rel.target_entity || '|' AS VARCHAR(1100))
    FROM walked AS wlk
    INNER JOIN {{ product }}_Semantic.table_relationship AS rel
        ON  rel.source_entity = wlk.destination_entity
        AND rel.is_active     = 1
    WHERE wlk.hop_count < 4
      AND POSITION('|' || rel.target_entity || '|' IN wlk.visited_entities) = 0

    UNION ALL
    -- Recursive: reverse
    SELECT CAST(wlk.path_id || TRIM(rel.relationship_id) || '<' AS VARCHAR(200))
         , wlk.origin_entity
         , rel.source_entity
         , wlk.hop_count + 1
         , CAST(wlk.visited_entities || rel.source_entity || '|' AS VARCHAR(1100))
    FROM walked AS wlk
    INNER JOIN {{ product }}_Semantic.table_relationship AS rel
        ON  rel.target_entity = wlk.destination_entity
        AND rel.is_active     = 1
    WHERE wlk.hop_count < 4
      AND POSITION('|' || rel.source_entity || '|' IN wlk.visited_entities) = 0
)
SELECT
      lgs.path_id
    , lgs.origin_entity
    , lgs.destination_entity
    , lgs.hop_count
    , lgs.hop
    , edg.key_ordinal
    , edg.from_entity
    , edg.from_column
    , edg.to_entity
    , edg.to_column
    , edg.relationship_id
    , edg.direction
FROM (
    -- One row per leg of each path: the hop-th leg of path_id is a relationship id and its direction.
    SELECT wlk.path_id, wlk.origin_entity, wlk.destination_entity, wlk.hop_count
         , hps.hop
         , REGEXP_SUBSTR(wlk.path_id, '[^<>]+[<>]', 1, hps.hop) AS leg
    FROM walked AS wlk
    INNER JOIN (
        SELECT CAST(1 AS INTEGER) AS hop
        UNION ALL SELECT CAST(2 AS INTEGER)
        UNION ALL SELECT CAST(3 AS INTEGER)
        UNION ALL SELECT CAST(4 AS INTEGER)
    ) AS hps
        ON hps.hop <= wlk.hop_count
) AS lgs
INNER JOIN {{ product }}_Semantic.relationship_edges AS edg
    ON  edg.relationship_id = CAST(SUBSTRING(lgs.leg FROM 1 FOR CHARACTER_LENGTH(lgs.leg) - 1) AS INTEGER)
    AND edg.direction = CASE WHEN SUBSTRING(lgs.leg FROM CHARACTER_LENGTH(lgs.leg) FOR 1) = '>'
                             THEN 'FORWARD' ELSE 'REVERSE' END;

COMMENT ON VIEW {{ product }}_Semantic.relationship_paths IS
'Multi-hop relationship paths between any two entities, bidirectional, up to 4 hops, never revisiting an entity. One row per hop per key position; the agent assembles the JOIN from the rows.';
COMMENT ON COLUMN {{ product }}_Semantic.relationship_paths.path_id IS 'The ordered legs of the path, each a relationship id then > (FORWARD) or < (REVERSE) - 12>7< is relationship 12 forward, then 7 in reverse.';
COMMENT ON COLUMN {{ product }}_Semantic.relationship_paths.origin_entity IS 'Entity the whole path starts from - the logical identity.';
COMMENT ON COLUMN {{ product }}_Semantic.relationship_paths.destination_entity IS 'Entity the whole path ends at - the logical identity.';
COMMENT ON COLUMN {{ product }}_Semantic.relationship_paths.hop_count IS 'Number of steps in the path, 1 to 4.';
COMMENT ON COLUMN {{ product }}_Semantic.relationship_paths.hop IS 'Position of this step in the path, from 1.';
COMMENT ON COLUMN {{ product }}_Semantic.relationship_paths.key_ordinal IS 'Position of the column pair within the relationship join group, from 1.';
COMMENT ON COLUMN {{ product }}_Semantic.relationship_paths.from_entity IS 'Entity this step leaves.';
COMMENT ON COLUMN {{ product }}_Semantic.relationship_paths.from_column IS 'Column on from_entity in this join pair.';
COMMENT ON COLUMN {{ product }}_Semantic.relationship_paths.to_entity IS 'Entity this step reaches.';
COMMENT ON COLUMN {{ product }}_Semantic.relationship_paths.to_column IS 'Column on to_entity in this join pair.';
COMMENT ON COLUMN {{ product }}_Semantic.relationship_paths.relationship_id IS 'Relationship this step traverses - table_relationship.relationship_id.';
COMMENT ON COLUMN {{ product }}_Semantic.relationship_paths.direction IS 'FORWARD crosses the relationship source to target, REVERSE target to source.';

