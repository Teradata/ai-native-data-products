-- Semantic module. Teradata invariant / validator checks.
-- Backs the invariants in design/modules/semantic.md; canonical STRUCTURAL/SEMANTIC checks the validation
-- pattern lifts. Each query must return ZERO rows for a conforming deployment. Replace {{ product }}.

-- INV-SEMANTIC-003: orphan module references (primary object with no live module)
SELECT po.primary_object_id, po.module_id
FROM {{ product }}_Semantic.data_product_map_primary_objects AS po
WHERE po.is_active = 1
  AND NOT EXISTS (
      SELECT 1 FROM {{ product }}_Semantic.data_product_map AS m
      WHERE m.module_id = po.module_id AND m.is_active = 1);

-- INV-SEMANTIC-003: registered objects missing from the catalogue, or catalogue-kind mismatch
SELECT po.database_name, po.object_name, po.table_kind, t.TableKind AS actual_kind
FROM {{ product }}_Semantic.data_product_map_primary_objects AS po
LEFT JOIN DBC.TablesV AS t
    ON t.DatabaseName = po.database_name AND t.TableName = po.object_name
WHERE po.is_active = 1
  AND (t.TableName IS NULL
       OR (po.table_kind IS NOT NULL AND TRIM(t.TableKind) <> TRIM(po.table_kind)));

-- INV-SEMANTIC-003/007: invalid object roles
SELECT po.primary_object_id, po.object_role
FROM {{ product }}_Semantic.data_product_map_primary_objects AS po
WHERE po.object_role NOT IN
    ('AGENT_ENTRYPOINT','ANALYTICAL_QUERY','REFERENCE_LOOKUP','RELATIONSHIP_BRIDGE',
     'LINEAGE_EVIDENCE','OPERATIONAL_METRIC','WRITE_TARGET','INTERNAL_SUPPORT');

-- INV-SEMANTIC-003: duplicate active registrations
SELECT po.module_id, po.database_name, po.object_name, COUNT(*) AS regs
FROM {{ product }}_Semantic.data_product_map_primary_objects AS po
WHERE po.is_active = 1
GROUP BY po.module_id, po.database_name, po.object_name
HAVING COUNT(*) > 1;

-- INV-SEMANTIC-007: more than one active primary exposure per base table
SELECT vm.base_database, vm.base_table, COUNT(*) AS primaries
FROM {{ product }}_Semantic.view_metadata AS vm
WHERE vm.is_active = 1 AND vm.is_primary = 1
GROUP BY vm.base_database, vm.base_table
HAVING COUNT(*) > 1;

-- INV-SEMANTIC-005: governed base tables with no registered exposure
SELECT e.database_name, e.table_name
FROM {{ product }}_Semantic.entity_metadata AS e
WHERE e.is_active = 1
  AND NOT EXISTS (
      SELECT 1 FROM {{ product }}_Semantic.view_metadata AS vm
      WHERE vm.base_database = e.database_name AND vm.base_table = e.table_name AND vm.is_active = 1);

-- INV-SEMANTIC-005: isolated entities (in entity_metadata but no relationship)
SELECT ent.entity_name
FROM {{ product }}_Semantic.entity_metadata AS ent
WHERE ent.is_active = 1
  AND NOT EXISTS (
      SELECT 1 FROM {{ product }}_Semantic.table_relationship AS rel
      WHERE rel.is_active = 1
        AND (rel.source_entity = ent.entity_name OR rel.target_entity = ent.entity_name));
-- An isolated entity is either a documented standalone (record a Design_Decision) or an omission.

-- INV-SEMANTIC-008: registered access object that is not actually deployed
SELECT a.database_name, a.object_name
FROM {{ product }}_Semantic.access_object AS a
LEFT JOIN DBC.TablesV AS t
    ON t.DatabaseName = a.database_name AND t.TableName = a.object_name
WHERE a.is_active = 1 AND t.TableName IS NULL;

-- INV-SEMANTIC-009: non-composite consumable object resolving to no entity
SELECT a.access_object_id, a.database_name, a.object_name
FROM {{ product }}_Semantic.access_object AS a
WHERE a.is_active = 1
  AND a.access_role <> 'COMPOSITE'
  AND a.represents_entity IS NULL;

-- INV-SEMANTIC-009: represents_entity that is not a catalogued entity
SELECT a.access_object_id, a.represents_entity
FROM {{ product }}_Semantic.access_object AS a
WHERE a.is_active = 1
  AND a.represents_entity IS NOT NULL
  AND NOT EXISTS (
      SELECT 1 FROM {{ product }}_Semantic.entity_metadata AS e
      WHERE e.is_active = 1 AND e.entity_name = a.represents_entity);

-- INV-SEMANTIC-009: composition member_entity that is not a catalogued entity
SELECT c.access_composition_id, c.member_entity
FROM {{ product }}_Semantic.access_composition AS c
WHERE c.is_active = 1
  AND NOT EXISTS (
      SELECT 1 FROM {{ product }}_Semantic.entity_metadata AS e
      WHERE e.is_active = 1 AND e.entity_name = c.member_entity);

-- INV-SEMANTIC-010: a COMPOSITE access object without a described composition
SELECT a.object_identity, a.database_name, a.object_name
FROM {{ product }}_Semantic.access_object AS a
WHERE a.is_active = 1 AND a.access_role = 'COMPOSITE'
  AND NOT EXISTS (
      SELECT 1 FROM {{ product }}_Semantic.access_composition AS c
      WHERE c.is_active = 1
        AND c.composite_object = a.object_identity);

-- INV-SEMANTIC-010, INV-SEMANTIC-020: composition without exactly one ANCHOR member
SELECT c.composite_object,
       SUM(CASE WHEN c.member_role = 'ANCHOR' THEN 1 ELSE 0 END) AS anchors
FROM {{ product }}_Semantic.access_composition AS c
WHERE c.is_active = 1
GROUP BY c.composite_object
HAVING SUM(CASE WHEN c.member_role = 'ANCHOR' THEN 1 ELSE 0 END) <> 1;

-- INV-SEMANTIC-011: missing required baseline orientation role for a product
SELECT r.product_id, req.resource_role
FROM {{ product }}_Semantic.data_product_orientation AS r
CROSS JOIN (SELECT 'MANIFEST' AS resource_role
      UNION SELECT 'TRUST_MAP' UNION SELECT 'MODULE_MAP'
      UNION SELECT 'OBJECT_CATALOGUE' UNION SELECT 'ENTITY_CATALOGUE'
      UNION SELECT 'COLUMN_CATALOGUE' UNION SELECT 'RELATIONSHIP_CATALOGUE') AS req
WHERE r.is_active = 1
  AND NOT EXISTS (
      SELECT 1 FROM {{ product }}_Semantic.data_product_orientation AS o
      WHERE o.product_id = r.product_id AND o.is_active = 1
        AND (o.resource_role = req.resource_role
             -- TRUST_GATE is the legacy spelling of TRUST_MAP; either satisfies the role.
             OR (req.resource_role = 'TRUST_MAP' AND o.resource_role = 'TRUST_GATE')))
GROUP BY r.product_id, req.resource_role;

-- INV-SEMANTIC-011: duplicate active role for one product (each role is singular). TRUST_GATE and
-- TRUST_MAP are the same role under two spellings (see the manifest's alias projection below), so
-- they are canonicalised before grouping - otherwise a product publishing both passes this check.
SELECT product_id, canonical_resource_role, COUNT(*) AS n
FROM (
    SELECT product_id
         , CASE WHEN resource_role IN ('TRUST_MAP', 'TRUST_GATE') THEN 'TRUST_MAP'
                ELSE resource_role
           END AS canonical_resource_role
    FROM {{ product }}_Semantic.data_product_orientation
    WHERE is_active = 1
) AS c
GROUP BY product_id, canonical_resource_role
HAVING COUNT(*) > 1;

-- INV-SEMANTIC-011: duplicate discovery_order for one product
SELECT product_id, discovery_order, COUNT(*) AS n
FROM {{ product }}_Semantic.data_product_orientation
WHERE is_active = 1
GROUP BY product_id, discovery_order
HAVING COUNT(*) > 1;

-- INV-SEMANTIC-011: object-backed orientation resource that is not deployed
SELECT o.product_id, o.resource_role, o.fully_qualified_object_name
FROM {{ product }}_Semantic.data_product_orientation AS o
LEFT JOIN DBC.TablesV AS t
    ON t.DatabaseName = o.database_name AND t.TableName = o.object_name
WHERE o.is_active = 1 AND o.object_name IS NOT NULL AND t.TableName IS NULL;

-- INV-SEMANTIC-011: trust map not ordered before every analytical resource
SELECT o.product_id
FROM {{ product }}_Semantic.data_product_orientation AS o
WHERE o.is_active = 1
  AND o.resource_role IN ('ENTITY_CATALOGUE', 'COLUMN_CATALOGUE', 'RELATIONSHIP_CATALOGUE',
                          'RELATIONSHIP_PATHS', 'QUERY_COOKBOOK')
  AND o.discovery_order < (
      SELECT MIN(g.discovery_order)
      FROM {{ product }}_Semantic.data_product_orientation AS g
      WHERE g.product_id = o.product_id AND g.is_active = 1
        AND g.resource_role IN ('TRUST_MAP', 'TRUST_GATE'));

-- INV-SEMANTIC-012: a manifest entrypoint with no backing active orientation row
SELECT m.product_id
FROM {{ product }}_Semantic.data_product_manifest AS m
WHERE m.manifest_entrypoint IS NULL
   OR m.trust_map_entrypoint IS NULL
   OR m.entity_catalogue_entrypoint IS NULL;

-- VAL-13: the product designates the producer whose trust map is authoritative. An implicit
-- designation is not readable, so a product with a validator and no designation has two maps
-- and no statement of which one it means.
SELECT m.product_id
FROM {{ product }}_Semantic.data_product_manifest AS m
WHERE m.trust_authoritative_producer IS NULL
   OR TRIM(m.trust_authoritative_producer) = '';
-- INV-SEMANTIC-013: a registered metric with no expression
SELECT m.metric_name
FROM {{ product }}_Semantic.metric_metadata AS m
WHERE m.is_active = 1
  AND NOT EXISTS (
      SELECT 1 FROM {{ product }}_Semantic.metric_expression AS x
      WHERE x.metric_name = m.metric_name AND x.is_active = 1);

-- INV-SEMANTIC-013: the same dialect declared twice for one metric
SELECT x.metric_name, x.sql_dialect, COUNT(*) AS expressions
FROM {{ product }}_Semantic.metric_expression AS x
WHERE x.is_active = 1
GROUP BY x.metric_name, x.sql_dialect
HAVING COUNT(*) > 1;

-- INV-SEMANTIC-014: a metric dataset that is not a registered active entity
SELECT d.metric_name, d.entity_name
FROM {{ product }}_Semantic.metric_dataset AS d
WHERE d.is_active = 1
  AND NOT EXISTS (
      SELECT 1 FROM {{ product }}_Semantic.entity_metadata AS e
      WHERE e.entity_name = d.entity_name AND e.is_active = 1);

-- INV-SEMANTIC-014: a metric without exactly one primary dataset
SELECT m.metric_name, COUNT(d.metric_dataset_id) AS primary_datasets
FROM {{ product }}_Semantic.metric_metadata AS m
LEFT OUTER JOIN {{ product }}_Semantic.metric_dataset AS d
    ON d.metric_name = m.metric_name AND d.dataset_role = 'PRIMARY' AND d.is_active = 1
WHERE m.is_active = 1
GROUP BY m.metric_name
HAVING COUNT(d.metric_dataset_id) <> 1;

-- INV-SEMANTIC-015: a synonym that resolves to nothing
SELECT s.object_kind, s.object_name, s.column_name, s.synonym_text
FROM {{ product }}_Semantic.semantic_synonym AS s
WHERE s.is_active = 1
  AND NOT (   (s.object_kind = 'ENTITY'
               AND EXISTS (SELECT 1 FROM {{ product }}_Semantic.entity_metadata AS e
                           WHERE e.entity_name = s.object_name AND e.is_active = 1))
           OR (s.object_kind = 'COLUMN'
               AND EXISTS (SELECT 1 FROM {{ product }}_Semantic.entity_metadata AS e
                           INNER JOIN {{ product }}_Semantic.column_metadata AS c
                               ON  c.database_name = e.database_name
                               AND c.table_name    = e.table_name
                           WHERE e.entity_name = s.object_name AND e.is_active = 1
                             AND c.column_name = s.column_name AND c.is_active = 1))
           OR (s.object_kind = 'METRIC'
               AND EXISTS (SELECT 1 FROM {{ product }}_Semantic.metric_metadata AS m
                           WHERE m.metric_name = s.object_name AND m.is_active = 1)));

-- INV-SEMANTIC-015: the same synonym registered twice against one object
SELECT s.object_kind, s.object_name, s.column_name, s.synonym_text, COUNT(*) AS registrations
FROM {{ product }}_Semantic.semantic_synonym AS s
WHERE s.is_active = 1
GROUP BY s.object_kind, s.object_name, s.column_name, s.synonym_text
HAVING COUNT(*) > 1;

-- INV-SEMANTIC-016: an entity identity that is not module.entity in lower case
SELECT ent.entity_name
FROM {{ product }}_Semantic.entity_metadata AS ent
WHERE ent.is_active = 1
  AND REGEXP_SIMILAR(ent.entity_name, '[a-z][a-z0-9_]*[.][a-z][a-z0-9_]*', 'c') = 0;

-- INV-SEMANTIC-016: an access or primary-object identity outside the grammar
-- (module.entity, module.entity:base|current, module:object, composite:name)
SELECT idn.identity_kind, idn.identity_value
FROM (
    SELECT CAST('ACCESS_OBJECT' AS VARCHAR(20)) AS identity_kind, a.object_identity AS identity_value
    FROM {{ product }}_Semantic.access_object AS a
    WHERE a.is_active = 1
    UNION ALL
    SELECT CAST('PRIMARY_OBJECT' AS VARCHAR(20)), p.object_identity
    FROM {{ product }}_Semantic.data_product_map_primary_objects AS p
    WHERE p.is_active = 1
) AS idn
WHERE REGEXP_SIMILAR(idn.identity_value,
          '([a-z][a-z0-9_]*[.][a-z][a-z0-9_]*(:(base|current))?|[a-z][a-z0-9_]*:[a-z][a-z0-9_]*)', 'c') = 0;

-- INV-SEMANTIC-016: an entity identity whose qualifier is not its own module, which is how a
-- placement-bound identity (a container name in front of the entity) shows up
SELECT ent.entity_name, ent.module_name
FROM {{ product }}_Semantic.entity_metadata AS ent
WHERE ent.is_active = 1
  AND ent.entity_name NOT LIKE LOWER(ent.module_name) || '.%';

-- INV-SEMANTIC-016: an entity identity registered more than once
SELECT e.entity_name, COUNT(*) AS registrations
FROM {{ product }}_Semantic.entity_metadata AS e
WHERE e.is_active = 1
GROUP BY e.entity_name
HAVING COUNT(*) > 1;

-- INV-SEMANTIC-017: an entity with no SURROGATE key definition
SELECT ent.entity_name
FROM {{ product }}_Semantic.entity_metadata AS ent
WHERE ent.is_active = 1
  AND NOT EXISTS (
      SELECT 1 FROM {{ product }}_Semantic.key_definition AS kdf
      WHERE kdf.entity_name = ent.entity_name
        AND kdf.key_role    = 'SURROGATE'
        AND kdf.is_active   = 1);

-- INV-SEMANTIC-017: a key definition for an uncatalogued entity
SELECT kdf.key_id, kdf.entity_name
FROM {{ product }}_Semantic.key_definition AS kdf
WHERE kdf.is_active = 1
  AND NOT EXISTS (
      SELECT 1 FROM {{ product }}_Semantic.entity_metadata AS ent
      WHERE ent.entity_name = kdf.entity_name AND ent.is_active = 1);

-- INV-SEMANTIC-017: a key with no columns, or ordinals that do not run 1..n without gaps
SELECT kdf.key_id, COUNT(kcl.key_column_id) AS key_columns
FROM {{ product }}_Semantic.key_definition AS kdf
LEFT OUTER JOIN {{ product }}_Semantic.key_column AS kcl
    ON kcl.key_id = kdf.key_id AND kcl.is_active = 1
WHERE kdf.is_active = 1
GROUP BY kdf.key_id
HAVING COUNT(kcl.key_column_id) = 0
    OR MIN(kcl.ordinal) <> 1
    OR MAX(kcl.ordinal) <> COUNT(kcl.key_column_id)
    OR COUNT(DISTINCT kcl.ordinal) <> COUNT(kcl.key_column_id);

-- INV-SEMANTIC-017: a key column that does not exist on the entity table
SELECT kdf.key_id, kcl.ordinal, kcl.column_name
FROM {{ product }}_Semantic.key_column AS kcl
INNER JOIN {{ product }}_Semantic.key_definition AS kdf
    ON kdf.key_id = kcl.key_id AND kdf.is_active = 1
INNER JOIN {{ product }}_Semantic.entity_metadata AS ent
    ON ent.entity_name = kdf.entity_name AND ent.is_active = 1
WHERE kcl.is_active = 1
  AND NOT EXISTS (
      SELECT 1 FROM DBC.ColumnsV AS dcl
      WHERE dcl.DatabaseName = ent.database_name
        AND dcl.TableName    = ent.table_name
        AND dcl.ColumnName   = kcl.column_name);

-- INV-SEMANTIC-018: a relationship with no column pair, or ordinals that do not run 1..n without gaps
SELECT rel.relationship_id, COUNT(rcl.relationship_column_id) AS column_pairs
FROM {{ product }}_Semantic.table_relationship AS rel
LEFT OUTER JOIN {{ product }}_Semantic.relationship_column AS rcl
    ON rcl.relationship_id = rel.relationship_id AND rcl.is_active = 1
WHERE rel.is_active = 1
GROUP BY rel.relationship_id
HAVING COUNT(rcl.relationship_column_id) = 0
    OR MIN(rcl.ordinal) <> 1
    OR MAX(rcl.ordinal) <> COUNT(rcl.relationship_column_id)
    OR COUNT(DISTINCT rcl.ordinal) <> COUNT(rcl.relationship_column_id);

-- INV-SEMANTIC-018: a relationship column that does not exist on its entity table
SELECT rcl.relationship_id, rcl.ordinal, rcl.source_column, rcl.target_column
FROM {{ product }}_Semantic.relationship_column AS rcl
INNER JOIN {{ product }}_Semantic.table_relationship AS rel
    ON rel.relationship_id = rcl.relationship_id AND rel.is_active = 1
WHERE rcl.is_active = 1
  AND (   NOT EXISTS (
              SELECT 1
              FROM {{ product }}_Semantic.entity_metadata AS sen
              INNER JOIN DBC.ColumnsV AS dcs
                  ON  dcs.DatabaseName = sen.database_name
                  AND dcs.TableName    = sen.table_name
              WHERE sen.entity_name = rel.source_entity
                AND sen.is_active   = 1
                AND dcs.ColumnName  = rcl.source_column)
       OR NOT EXISTS (
              SELECT 1
              FROM {{ product }}_Semantic.entity_metadata AS ten
              INNER JOIN DBC.ColumnsV AS dct
                  ON  dct.DatabaseName = ten.database_name
                  AND dct.TableName    = ten.table_name
              WHERE ten.entity_name = rel.target_entity
                AND ten.is_active   = 1
                AND dct.ColumnName  = rcl.target_column));

-- INV-SEMANTIC-019: an output column of an agent-consumable object with no access_column row
SELECT aob.object_identity, dcl.ColumnName
FROM {{ product }}_Semantic.access_object AS aob
INNER JOIN DBC.ColumnsV AS dcl
    ON  dcl.DatabaseName = aob.database_name
    AND dcl.TableName    = aob.object_name
WHERE aob.is_active = 1
  AND aob.is_agent_consumable = 1
  AND NOT EXISTS (
      SELECT 1 FROM {{ product }}_Semantic.access_column AS acl
      WHERE acl.object_identity = aob.object_identity
        AND acl.column_name     = dcl.ColumnName
        AND acl.is_active       = 1);

-- INV-SEMANTIC-019: a column mapped more than once, or mapped but not an output column of its object
SELECT acl.object_identity, acl.column_name, COUNT(*) AS mappings
FROM {{ product }}_Semantic.access_column AS acl
WHERE acl.is_active = 1
GROUP BY acl.object_identity, acl.column_name
HAVING COUNT(*) > 1;

SELECT acl.object_identity, acl.column_name
FROM {{ product }}_Semantic.access_column AS acl
INNER JOIN {{ product }}_Semantic.access_object AS aob
    ON  aob.object_identity     = acl.object_identity
    AND aob.is_active           = 1
    AND aob.is_agent_consumable = 1
WHERE acl.is_active = 1
  AND NOT EXISTS (
      SELECT 1 FROM DBC.ColumnsV AS dcl
      WHERE dcl.DatabaseName = aob.database_name
        AND dcl.TableName    = aob.object_name
        AND dcl.ColumnName   = acl.column_name);

-- INV-SEMANTIC-019: a non-derived mapping whose source column does not exist
SELECT acl.object_identity, acl.column_name, acl.source_entity, acl.source_column
FROM {{ product }}_Semantic.access_column AS acl
WHERE acl.is_active = 1
  AND acl.mapping_kind <> 'DERIVED'
  AND NOT EXISTS (
      SELECT 1
      FROM {{ product }}_Semantic.entity_metadata AS ent
      INNER JOIN DBC.ColumnsV AS dcl
          ON  dcl.DatabaseName = ent.database_name
          AND dcl.TableName    = ent.table_name
      WHERE ent.entity_name = acl.source_entity
        AND ent.is_active   = 1
        AND dcl.ColumnName  = acl.source_column);

-- INV-SEMANTIC-020: member_seq that does not run 1..n without gaps within a composite
SELECT cmp.composite_object
FROM {{ product }}_Semantic.access_composition AS cmp
WHERE cmp.is_active = 1
GROUP BY cmp.composite_object
HAVING MIN(cmp.member_seq) <> 1
    OR MAX(cmp.member_seq) <> COUNT(*)
    OR COUNT(DISTINCT cmp.member_seq) <> COUNT(*);

-- INV-SEMANTIC-020: a non-anchor member whose via relationship does not exist or does not join
-- it to a prior member in the stated direction (FORWARD: prior member is the source)
SELECT cmp.composite_object, cmp.member_seq, cmp.member_entity, cmp.via_relationship_id, cmp.via_direction
FROM {{ product }}_Semantic.access_composition AS cmp
WHERE cmp.is_active = 1
  AND cmp.member_role <> 'ANCHOR'
  AND NOT EXISTS (
      SELECT 1
      FROM {{ product }}_Semantic.table_relationship AS rel
      INNER JOIN {{ product }}_Semantic.access_composition AS pri
          ON  pri.composite_object = cmp.composite_object
          AND pri.member_seq       < cmp.member_seq
          AND pri.is_active        = 1
      WHERE rel.relationship_id = cmp.via_relationship_id
        AND rel.is_active       = 1
        AND (   (cmp.via_direction = 'FORWARD'
                 AND rel.source_entity = pri.member_entity
                 AND rel.target_entity = cmp.member_entity)
             OR (cmp.via_direction = 'REVERSE'
                 AND rel.target_entity = pri.member_entity
                 AND rel.source_entity = cmp.member_entity)));
