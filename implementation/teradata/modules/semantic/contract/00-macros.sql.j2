{# Shared by the Semantic metadata-contract checks (INV-SEMANTIC-016 to 020). A standard-owned
   relation is read through the physical names the build context places; nothing here composes
   one. Every check returns two columns, the object_identity at fault and the defect, each cast
   to a stated width because a union takes its text widths from its first branch. #}
{% macro tbl(name) -%}{{ named(name).objects.table|qualified }}{%- endmacro %}
{% macro col(name, column) -%}{{ named(name).column_names[column]|ident }}{%- endmacro %}
{% macro pk(name) -%}{{ named(name).key_columns[0]|ident }}{%- endmacro %}
{# The object a defect is about, cast to the check's identity width. #}
{% macro who(expression) -%}CAST({{ expression }} AS VARCHAR(500)){%- endmacro %}
{# What is wrong with it. #}
{% macro what(text) -%}CAST({{ text|literal }} AS VARCHAR(100)){%- endmacro %}
{# A run of ordinals is 1..n with no gaps and no repeats. #}
{% macro contiguous(alias, ordinal) -%}
COUNT(DISTINCT {{ alias }}.{{ ordinal }}) <> COUNT(*) OR MIN({{ alias }}.{{ ordinal }}) <> 1 OR MAX({{ alias }}.{{ ordinal }}) <> COUNT(*)
{%- endmacro %}
{# A column of a table or view, from the dictionary: true when `alias` names one for the given container, object and column expressions. #}
{% macro has_column(alias, container, object, column) -%}
TRIM({{ alias }}.DatabaseName) = {{ container }} AND TRIM({{ alias }}.TableName) = {{ object }} AND TRIM({{ alias }}.ColumnName) = {{ column }}
{%- endmacro %}
