{# Rendered per persisted relation, with `entity`. Every returned row is a defect in the
   temporal profile's invariants: an empty interval, a current flag that disagrees with the
   open axes, more than one open version of an identity, overlapping versions, or a tombstone
   without its instant. Teradata enforces none of the cross-row rules in its schema. #}
{% import 'patterns/temporal-lifecycle-metadata/00-macros.sql.j2' as m with context %}
{% set x = entity %}{% set cn = x.column_names %}{% set t = x.objects.table|qualified %}
{% set id = x.version_columns or x.key_columns %}
SELECT {% for k in id %}a.{{ k|ident }}{% if not loop.last %}, {% endif %}{% endfor %} FROM {{ t }} a WHERE 1 = 0
{%- if x.history %}
 OR a.{{ cn.valid_from_dts|ident }} >= a.{{ cn.valid_to_dts|ident }}
 OR (a.{{ cn.is_current|ident }} = 1 AND NOT (a.{{ cn.valid_to_dts|ident }} = {{ m.sentinel() }}{% if x.bitemporal %} AND a.{{ cn.transaction_to_dts|ident }} = {{ m.sentinel() }}{% endif %}))
 OR (a.{{ cn.is_current|ident }} = 0 AND a.{{ cn.valid_to_dts|ident }} = {{ m.sentinel() }}{% if x.bitemporal %} AND a.{{ cn.transaction_to_dts|ident }} = {{ m.sentinel() }}{% endif %})
{%- if x.bitemporal %}
 OR a.{{ cn.transaction_from_dts|ident }} >= a.{{ cn.transaction_to_dts|ident }}
{%- endif %}
 OR EXISTS (SELECT 1 FROM {{ t }} b WHERE {% for k in id %}a.{{ k|ident }} = b.{{ k|ident }} AND {% endfor %}
     NOT (a.{{ cn.valid_from_dts|ident }} = b.{{ cn.valid_from_dts|ident }}{% if x.bitemporal %} AND a.{{ cn.transaction_from_dts|ident }} = b.{{ cn.transaction_from_dts|ident }}{% endif %})
     AND a.{{ cn.valid_from_dts|ident }} < b.{{ cn.valid_to_dts|ident }} AND b.{{ cn.valid_from_dts|ident }} < a.{{ cn.valid_to_dts|ident }}
{%- if x.bitemporal %}
     AND a.{{ cn.transaction_from_dts|ident }} < b.{{ cn.transaction_to_dts|ident }} AND b.{{ cn.transaction_from_dts|ident }} < a.{{ cn.transaction_to_dts|ident }}
{%- endif %})
{%- endif %}
{%- if x.supports_deletion and 'deleted_dts' in cn %}
 OR (a.{{ cn.is_deleted|ident }} = 1 AND a.{{ cn.deleted_dts|ident }} IS NULL)
 OR (a.{{ cn.is_deleted|ident }} = 0 AND a.{{ cn.deleted_dts|ident }} IS NOT NULL)
{%- endif %}
