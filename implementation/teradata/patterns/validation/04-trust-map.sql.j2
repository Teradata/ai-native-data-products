{# The trust map (Validation §§4, 10, 11): per area, the latest evidence from the product's
   designated producer, read at `unknown` confidence once past its expiry or the product's
   evidence window, graded against the run that produced it; a run at a registered legacy
   wire version, which publishes no area records, projected as one PRODUCT entry capped at
   `partial` (a 2.1 run without areas is malformed, not legacy); and a `no-evidence` entry
   for a product with nothing published. Where no producer is designated, the most cautious
   producer's entry stands for each area. The same columns as every binding's trust map.
   Teradata views take no WITH clause or ORDER BY here, so the steps are derived tables and
   the latest-row choices are QUALIFY; a NULL in a union branch is typed, or the union fails. #}
{% set view = named('TrustMap') %}{% set run = named('ValidationRun') %}{% set area = named('ValidationArea') %}
{% set registry = named('DataProductRegistry') %}
{% if view and run and area and registry %}
{% set r = run.column_names %}{% set a = area.column_names %}{% set p = registry.column_names %}
{% set secs = (quality.evidence_window_days * 86400)|round|int %}
{% set window = "CAST('" ~ ('%d %02d:%02d:%02d'|format(secs // 86400, secs % 86400 // 3600, secs % 3600 // 60, secs % 60)) ~ "' AS INTERVAL DAY(4) TO SECOND)" %}
{% set product -%}
(SELECT {{ p.product_id|ident }} AS product_code,
        CASE WHEN TRIM({{ p.trust_authoritative_producer|ident }}) = '' THEN NULL ELSE {{ p.trust_authoritative_producer|ident }} END AS producer_id
 FROM {{ registry.objects.table|qualified }} WHERE {{ p.is_active|ident }} = 1 AND {{ p.is_deleted|ident }} = 0)
{%- endset %}
{% set evidence -%}
(SELECT x.{{ a.product_code|ident }} AS product_code, x.{{ a.producer_id|ident }} AS producer_id,
        x.{{ a.run_id|ident }} AS run_id, x.{{ a.scope_kind|ident }} AS scope_kind, x.{{ a.scope_id|ident }} AS scope_id,
        x.{{ a.area_status|ident }} AS area_status, x.{{ a.confidence|ident }} AS confidence,
        x.{{ a.checks_expected|ident }} AS checks_expected, x.{{ a.checks_ran|ident }} AS checks_ran,
        x.{{ a.passed_count|ident }} AS passed_count, x.{{ a.failed_count|ident }} AS failed_count,
        x.{{ a.error_count|ident }} AS error_count, x.{{ a.critical_failure_count|ident }} AS critical_failure_count,
        x.{{ a.error_failure_count|ident }} AS error_failure_count,
        CAST(x.{{ a.open_gaps|ident }} AS VARCHAR(4000)) AS open_gaps,
        CAST(x.{{ a.recommended_action|ident }} AS VARCHAR(4000)) AS recommended_action,
        x.{{ a.completed_dts|ident }} AS completed_dts, y.{{ r.evidence_expires_dts|ident }} AS evidence_expires_dts,
        0 AS derived
 FROM {{ area.objects.table|qualified }} x
 JOIN {{ run.objects.table|qualified }} y ON y.{{ r.product_code|ident }} = x.{{ a.product_code|ident }}
  AND y.{{ r.producer_id|ident }} = x.{{ a.producer_id|ident }} AND y.{{ r.run_id|ident }} = x.{{ a.run_id|ident }}
 UNION ALL
 SELECT y.{{ r.product_code|ident }}, y.{{ r.producer_id|ident }}, y.{{ r.run_id|ident }}, 'PRODUCT', y.{{ r.product_code|ident }},
        CASE WHEN y.{{ r.total_checks|ident }} = 0 THEN 'no-evidence'
             WHEN y.{{ r.failed_count|ident }} = 0 AND y.{{ r.error_count|ident }} = 0 THEN 'pass' ELSE 'fail' END,
        CASE WHEN y.{{ r.total_checks|ident }} = 0 THEN 'unknown'
             WHEN y.{{ r.critical_failure_count|ident }} + y.{{ r.error_failure_count|ident }} > 0 THEN 'weak'
             ELSE 'partial' END,
        y.{{ r.total_checks|ident }}, y.{{ r.total_checks|ident }}, y.{{ r.passed_count|ident }}, y.{{ r.failed_count|ident }},
        y.{{ r.error_count|ident }}, y.{{ r.critical_failure_count|ident }}, y.{{ r.error_failure_count|ident }},
        'Derived from a run with no area records.', CAST(NULL AS VARCHAR(4000)), y.{{ r.completed_dts|ident }}, y.{{ r.evidence_expires_dts|ident }}, 1
 FROM {{ run.objects.table|qualified }} y
 WHERE y.{{ r.payload_schema_version|ident }} IN ({% for v in quality.legacy_wire_versions %}{{ v|literal }}{% if not loop.last %}, {% endif %}{% endfor %})
   AND NOT EXISTS (SELECT 1 FROM {{ area.objects.table|qualified }} x WHERE x.{{ a.product_code|ident }} = y.{{ r.product_code|ident }}
                   AND x.{{ a.producer_id|ident }} = y.{{ r.producer_id|ident }} AND x.{{ a.run_id|ident }} = y.{{ r.run_id|ident }}))
{%- endset %}
REPLACE VIEW {{ view.objects.consumer_view|qualified }} AS
LOCKING ROW FOR ACCESS
SELECT c.product_code, c.producer_id, c.run_id, c.scope_kind, c.scope_id, c.area_status,
       CASE WHEN c.stale = 1 THEN 'unknown' ELSE c.confidence END AS confidence,
       c.checks_expected, c.checks_ran,
       CAST(c.checks_ran AS FLOAT) / NULLIFZERO(c.checks_expected) AS coverage,
       c.passed_count, c.failed_count, c.error_count, c.critical_failure_count, c.error_failure_count,
       CASE WHEN c.stale = 1 THEN 'Evidence is stale since ' || CAST(COALESCE(c.evidence_expires_dts, c.completed_dts + {{ window }}) AS VARCHAR(40)) || '.' ELSE c.open_gaps END AS open_gaps,
       CASE WHEN c.stale = 1 THEN 'Re-run the validator; disclose unknown confidence.'
            WHEN c.designated IS NULL THEN 'No designated producer: cautious per-area fallback. ' || COALESCE(c.recommended_action, 'Designate one producer.')
            ELSE c.recommended_action END AS recommended_action,
       c.completed_dts, c.derived
FROM (
    SELECT l.*
    FROM (
        SELECT e.*, p.producer_id AS designated,
               CASE WHEN COALESCE(e.evidence_expires_dts, e.completed_dts + {{ window }}) < CURRENT_TIMESTAMP(6) THEN 1 ELSE 0 END AS stale
        FROM {{ evidence }} e
        JOIN {{ product }} p ON p.product_code = e.product_code AND (p.producer_id IS NULL OR p.producer_id = e.producer_id)
        QUALIFY ROW_NUMBER() OVER (PARTITION BY e.product_code, e.producer_id, e.scope_kind, e.scope_id
                                   ORDER BY e.completed_dts DESC, e.run_id DESC) = 1
    ) l
    QUALIFY ROW_NUMBER() OVER (PARTITION BY l.product_code, l.scope_kind, l.scope_id
                               ORDER BY CASE WHEN l.stale = 1 THEN 0
                                             ELSE CASE l.confidence WHEN 'unknown' THEN 0 WHEN 'weak' THEN 1 WHEN 'partial' THEN 2 ELSE 3 END END,
                                        l.completed_dts DESC, l.run_id DESC, l.producer_id) = 1
) c
UNION ALL
SELECT p.product_code, p.producer_id, CAST(NULL AS VARCHAR(400)), 'PRODUCT', p.product_code, 'no-evidence', 'unknown',
       0, 0, CAST(NULL AS FLOAT), 0, 0, 0, 0, 0, 'No published area evidence.', 'Run the validator before reporting confidence.',
       CAST(NULL AS TIMESTAMP(6) WITH TIME ZONE), 0
FROM {{ product }} p
WHERE NOT EXISTS (SELECT 1 FROM {{ evidence }} e WHERE e.product_code = p.product_code
                  AND (p.producer_id IS NULL OR e.producer_id = p.producer_id));
{% endif %}
