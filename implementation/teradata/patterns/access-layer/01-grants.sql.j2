{# The access tiers (Access Layer), once every object exists: the principals the build
   context names, created where the profile says the build creates them (CREATE ROLE needs
   the CREATE ROLE right), and the grants: read and agent tiers reach consumer views, and the
   history of versioned relations through their governed base views; the agent tier also writes its write targets; the admin tier maintains every database, with the
   rights a role may hold (ALL carries CREATE USER, which no role may). Grants are per
   object or per database as the profile's grant level says. A role comment names who the
   role is for and never what it reaches. The implied grants between databases are
   00-implied-grants. #}
{% import 'patterns/temporal-lifecycle-metadata/00-macros.sql.j2' as m with context %}
{% set read = principals.ROLE_READ.name %}{% set agent = principals.ROLE_AGENT.name %}{% set admin = principals.ROLE_ADMIN.name %}
{% set who = {'ROLE_READ': 'analyst and BI consumer role', 'ROLE_AGENT': 'AI agent and automated tool role',
              'ROLE_ADMIN': 'owner and data steward role'} %}
{% for tier in ('ROLE_READ', 'ROLE_AGENT', 'ROLE_ADMIN') if principals[tier].create %}
CREATE ROLE {{ principals[tier].name|ident }};
COMMENT ON ROLE {{ principals[tier].name|ident }} IS {{ m.comment(product.name ~ ' data product - ' ~ who[tier] ~ '.') }};
{%- endfor %}
{% for k in containers if k.holds_objects %}
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE TABLE, DROP TABLE, CREATE VIEW, DROP VIEW, STATISTICS ON {{ k.name|ident }} TO {{ admin|ident }};
{%- endfor %}
{# A database-level grant reaches only a database that holds no tables; consumer views that
   share a database with tables are granted one by one, so a grant never reaches a table. #}
{% set table_containers = module_containers|selectattr('role', 'equalto', 'table')|map(attribute='container')|list %}
{% set view_containers = module_containers|selectattr('role', 'equalto', 'consumer_view')|map(attribute='container')|unique|list %}
{% set whole = view_containers|reject('in', table_containers)|list if grant_level == 'container' else [] %}
{% for k in whole %}
GRANT SELECT ON {{ k|ident }} TO {{ read|ident }};
GRANT SELECT ON {{ k|ident }} TO {{ agent|ident }};
{%- endfor %}
{% for x in entities + relations if x.objects.consumer_view is defined and x.objects.consumer_view.container not in whole %}
GRANT SELECT ON {{ x.objects.consumer_view|qualified }} TO {{ read|ident }};
GRANT SELECT ON {{ x.objects.consumer_view|qualified }} TO {{ agent|ident }};
{%- endfor %}
{# History: the governed base view of each versioned relation consumers read, as other
   bindings grant their point-in-time functions (temporal-lifecycle-metadata §9). Base views
   share databases with tables under some placements, so these are always per view. #}
{% for x in entities + relations if x.history and x.objects.consumer_view is defined and x.objects.base_view is defined and x.objects.base_view.container not in whole %}
GRANT SELECT ON {{ x.objects.base_view|qualified }} TO {{ read|ident }};
GRANT SELECT ON {{ x.objects.base_view|qualified }} TO {{ agent|ident }};
{%- endfor %}
{% for x in entities + relations if x.objects.table is defined and x.objects.table.primary_role == 'WRITE_TARGET' %}
GRANT {% if x.runtime %}SELECT, INSERT, UPDATE{% else %}INSERT{% endif %} ON {{ x.objects.table|qualified }} TO {{ agent|ident }};
{%- endfor %}
