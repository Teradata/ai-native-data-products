-- Temporal & Lifecycle Metadata. DML maintenance patterns (Teradata).
-- Binding of the required invariants in design/patterns/temporal-lifecycle-metadata.md.
{#
  Template variables (build context):
    db            : container holding the table
    entity        : table name
    natural_key   : natural/business key column
    surrogate_key : surrogate key column
    attributes    : list of { name } business attributes the version carries
#}
-- This renders the maintenance statements for {{ db }}.{{ entity }}; :params are runtime values.
-- The open-end sentinel is written here, at INSERT time: it is deliberately not a
-- DEFAULT on the column (see PLATFORM_PROFILE, SQL idioms and driver constraints),
-- so every INSERT that opens a version states the sentinel explicitly.

-- 6.1 Standard version change (close + insert, one transaction).
-- Both statements commit or roll back together (invariant 7). The successor's
-- valid_from_dts equals the predecessor's new valid_to_dts (no gap, no overlap).
BT;

UPDATE {{ db }}.{{ entity }}
SET   valid_to_dts = :event_dts
    , is_current   = 0
    , updated_dts  = CURRENT_TIMESTAMP(6)
WHERE {{ natural_key }} = :{{ natural_key }}
  AND valid_to_dts = TIMESTAMP '9999-12-31 23:59:59.999999+00:00'
  -- Change detection: close only when the incoming version differs (invariant 6)
  AND ({% for a in attributes %}{{ a.name }} <> :new_{{ a.name }}{{ ' OR ' if not loop.last else '' }}{% endfor %});

INSERT INTO {{ db }}.{{ entity }}
      ({{ surrogate_key }}, {{ natural_key }}{% for a in attributes %}, {{ a.name }}{% endfor %}
     , valid_from_dts, valid_to_dts)
SELECT :new_sk, :{{ natural_key }}{% for a in attributes %}, :new_{{ a.name }}{% endfor %}
     , :event_dts, TIMESTAMP '9999-12-31 23:59:59.999999+00:00'
WHERE NOT EXISTS (
    SELECT 1 FROM {{ db }}.{{ entity }} AS a
    WHERE a.{{ natural_key }} = :{{ natural_key }}
      AND a.valid_from_dts = :event_dts
);   -- Idempotent replay: re-running the same input inserts nothing (invariant 8)

ET;

-- 6.2 Logical deletion: a NEW current version, never update-in-place (invariant 10).
BT;

UPDATE {{ db }}.{{ entity }}
SET valid_to_dts = :deletion_dts, is_current = 0, updated_dts = CURRENT_TIMESTAMP(6)
WHERE {{ natural_key }} = :{{ natural_key }}
  AND valid_to_dts = TIMESTAMP '9999-12-31 23:59:59.999999+00:00';

INSERT INTO {{ db }}.{{ entity }}
      ({{ surrogate_key }}, {{ natural_key }}{% for a in attributes %}, {{ a.name }}{% endfor %}
     , valid_from_dts, valid_to_dts, is_deleted, deleted_dts)
VALUES (:new_sk, :{{ natural_key }}{% for a in attributes %}, :last_{{ a.name }}{% endfor %}
     , :deletion_dts, TIMESTAMP '9999-12-31 23:59:59.999999+00:00'
     , 1, :deletion_dts);

ET;
-- Restoration inserts a further successor with is_deleted = 0.

-- 6.3 Late-arriving change (invariant 9): place the change at its actual effective
-- instant and split the covering period: close the covering version at :late_dts,
-- insert the late version [:late_dts, original_valid_to_dts), preserving is_current
-- on whichever row now holds the sentinel. Same close + insert transaction shape as 6.1.
