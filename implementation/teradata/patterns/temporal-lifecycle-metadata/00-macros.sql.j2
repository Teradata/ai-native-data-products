{#- Shared macros for the Teradata binding. Every name comes from the build context: `x` is an
    entity or a standard-owned relation, with its `columns`, `column_names`, key and
    versioning columns and placed `objects`. Nothing here composes a name.

    Platform constants (PLATFORM_PROFILE section 7): a Flag is BYTEINT 0/1; the open end of
    an interval is the sentinel below, stated by every statement that opens a version and
    never a DEFAULT, because the driver hangs parsing a zone-qualified literal in a
    CREATE TABLE DEFAULT; text columns are UNICODE so prose is not untranslatable. -#}
{%- set SENTINEL = "TIMESTAMP '9999-12-31 23:59:59.999999+00:00'" -%}

{% macro sentinel() -%}{{ SENTINEL }}{%- endmacro %}

{% macro cols(names) -%}
{%- for n in names %}{{ n|ident }}{% if not loop.last %}, {% endif %}{% endfor -%}
{%- endmacro %}

{% macro required(col) -%}
{{- col.required or (col.canonical and col.name != 'deleted_dts') -}}
{%- endmacro %}

{#- The table's primary index: a keymap is read by its natural key, a versioned table keeps
    an identity's versions on one AMP, and anything else is read by its key. -#}
{% macro primary_index(x) -%}
{%- if x.kind == 'Keymap' and x.natural_columns -%}UNIQUE PRIMARY INDEX ({{ cols(x.natural_columns) }})
{%- elif x.history -%}PRIMARY INDEX ({{ cols(x.version_columns) }})
{%- elif x.key_columns -%}UNIQUE PRIMARY INDEX ({{ cols(x.key_columns) }})
{%- else -%}PRIMARY INDEX ({{ x.columns[0].physical_name|ident }})
{%- endif -%}
{%- endmacro %}

{% macro unicode(col) -%}
{%- if col.physical_type.startswith('VARCHAR') or col.physical_type.startswith('CLOB') or col.physical_type == 'JSON' %} CHARACTER SET UNICODE{% endif -%}
{%- endmacro %}

{% macro column(x, col) -%}
{{ col.physical_name|ident }} {{ col.physical_type }}{{ unicode(col) }}
{%- if x.generated_key and col.physical_name in x.key_columns %} GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1 MINVALUE 1 NO CYCLE){% endif %}
{%- if required(col) == 'True' or col.physical_name in x.key_columns or col.physical_name in x.version_columns %} NOT NULL{% endif %}
{%- if col.unique and required(col) == 'True' and not x.history and col.physical_name not in x.key_columns and not (x.kind == 'Keymap' and col.physical_name in x.natural_columns) %} UNIQUE{% endif %}
{%- if col.members %} CHECK ({{ col.physical_name|ident }} IN ({% for m in col.members %}{{ m|literal }}{% if not loop.last %}, {% endif %}{% endfor %})){% endif %}
{%- if col.type == 'Flag' %} CHECK ({{ col.physical_name|ident }} IN (0, 1)){% endif %}
{%- endmacro %}

{#- The uniqueness the profile implies, beyond the primary index: one row per version of an
    identity, and a keymap's key, which the tables it allocates for reference. -#}
{% macro uniqueness(x) -%}
{%- set cn = x.column_names -%}
{%- if x.history %},
    UNIQUE ({{ cols(x.version_columns) }}, {{ cn.valid_from_dts|ident }}{% if x.bitemporal %}, {{ cn.transaction_from_dts|ident }}{% endif %})
{%- elif x.kind == 'Keymap' and x.key_columns %},
    PRIMARY KEY ({{ cols(x.key_columns) }})
{%- endif -%}
{%- endmacro %}

{% macro constraints(x) -%}
{%- set cn = x.column_names -%}
{%- if x.history %},
    CHECK ({{ cn.valid_from_dts|ident }} < {{ cn.valid_to_dts|ident }})
{%- if x.bitemporal %},
    CHECK ({{ cn.transaction_from_dts|ident }} < {{ cn.transaction_to_dts|ident }}){% endif -%}
{%- endif -%}
{%- endmacro %}

{% macro current(x, alias='') -%}
{%- set cn = x.column_names -%}
{%- if x.history %}{{ alias }}{{ cn.is_current|ident }} = 1 AND {{ alias }}{{ cn.valid_to_dts|ident }} = {{ SENTINEL }}{% if x.bitemporal %} AND {{ alias }}{{ cn.transaction_to_dts|ident }} = {{ SENTINEL }}{% endif %}{% else %}1 = 1{% endif -%}
{%- if x.supports_deletion %} AND {{ alias }}{{ cn.is_deleted|ident }} = 0{% endif -%}
{%- endmacro %}

{% macro keymap_of(x) -%}
{%- for k in entities if k.name == x.identity.keymap -%}{{ k.objects.table|qualified }} ({{ cols(k.key_columns) }}){%- endfor -%}
{%- endmacro %}

{% macro table(x) -%}
CREATE MULTISET TABLE {{ x.objects.table|qualified }} (
{%- for col in x.columns %}
    {{ column(x, col) }}{% if not loop.last %},{% endif %}
{%- endfor %}{{ uniqueness(x) }}{{ constraints(x) }}
{%- if x.identity is defined and x.identity.keymap %},
    FOREIGN KEY ({{ cols(x.key_columns) }}) REFERENCES WITH NO CHECK OPTION {{ keymap_of(x) }}{% endif %}
)
{{ primary_index(x) }};
{%- endmacro %}

{% macro value(v) -%}
{%- if v is none %}NULL{% elif v is sameas true %}1{% elif v is sameas false %}0{% elif v is number %}{{ v }}{% else %}{{ v|literal }}{% endif -%}
{%- endmacro %}

{#- A subquery for the key of the current row of `target` whose logical attributes match
    `match`, so a Reference is written as the identifier it refers to. -#}
{% macro ref(target, match) -%}
(SELECT {{ target.key_columns[0]|ident }} FROM {{ target.objects.table|qualified }} WHERE
{%- for k, v in match|dictsort %} {{ target.column_names[k]|ident }} = {{ value(v) }} AND{% endfor %} {{ current(target) }})
{%- endmacro %}

{#- Insert one row into a standard-owned relation by logical attribute name. `values` maps
    logical names to Python values; `sql` maps logical names to SQL expressions. Temporal
    columns not supplied take their open-row values. -#}
{% macro insert(rel, values, sql={}) -%}
{%- set defaults = {'created_dts': 'CURRENT_TIMESTAMP(6)', 'updated_dts': 'CURRENT_TIMESTAMP(6)',
                    'valid_from_dts': 'CURRENT_TIMESTAMP(6)', 'valid_to_dts': SENTINEL,
                    'transaction_from_dts': 'CURRENT_TIMESTAMP(6)', 'transaction_to_dts': SENTINEL,
                    'is_current': '1', 'is_deleted': '0', 'is_active': '1'} -%}
{%- set names = [] -%}{%- set exprs = [] -%}
{%- for col in rel.columns -%}
{%- if col.name in values -%}{%- set _ = names.append(col.physical_name) -%}{%- set _ = exprs.append(value(values[col.name])) -%}
{%- elif col.name in sql -%}{%- set _ = names.append(col.physical_name) -%}{%- set _ = exprs.append(sql[col.name]) -%}
{%- elif col.name in defaults and (col.origin == 'temporal' or col.name in ('is_active', 'is_deleted')) -%}{%- set _ = names.append(col.physical_name) -%}{%- set _ = exprs.append(defaults[col.name]) -%}
{%- endif -%}
{%- endfor -%}
INSERT INTO {{ rel.objects.table|qualified }} ({{ cols(names) }})
VALUES ({{ exprs|join(', ') }});
{%- endmacro %}

{#- Non-empty when a relation's Enum attribute permits the value, so a row is only written
    where the standard's vocabulary has a value for it. -#}
{% macro member(rel, attribute, value) -%}
{%- for col in rel.columns if col.name == attribute and value in col.members %}yes{% endfor -%}
{%- endmacro %}

{#- Every persisted relation of a module, keymaps first so references to them resolve. -#}
{% macro module_tables(module) -%}
{%- for keymaps in (true, false) -%}
{%- for x in entities + relations if x.module == module and x.relation == 'table' and (x.defined|default(true)) and not (x.adopted|default(false)) and ((x.kind == 'Keymap') == keymaps) %}
{{ table(x) }}
{%- endfor -%}
{%- endfor -%}
{%- endmacro %}

{#- A comment, held to the dictionary's 255-character limit (PLATFORM_PROFILE section 7). -#}
{% macro comment(text) -%}
{{- (text or '')|truncate(255, true, '', 0)|literal -}}
{%- endmacro %}
