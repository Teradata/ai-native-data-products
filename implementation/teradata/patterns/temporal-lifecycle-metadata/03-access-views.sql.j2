{# The governed base view of every persisted relation (this binding emits `base_view: all`):
   every column, every row, the full temporal contract. Then the consumer view: current rows
   only, without the open interval ends, which are always open on this surface. Point-in-time
   reads go through the base view with the profile's predicates; Teradata SQL has no table
   functions. Runtime relations have no consumer view. Views read with an access lock so a
   consumer never blocks a load. #}
{% import 'patterns/temporal-lifecycle-metadata/00-macros.sql.j2' as m with context %}
{% for x in entities + relations if x.relation == 'table' and (x.defined|default(true)) and x.objects.base_view is defined %}
REPLACE VIEW {{ x.objects.base_view|qualified }} AS
LOCKING ROW FOR ACCESS
SELECT {{ m.cols(x.columns|map(attribute='physical_name')) }}
FROM {{ x.objects.table|qualified }};
COMMENT ON VIEW {{ x.objects.base_view|qualified }} IS {{ m.comment('Governed full contract: ' ~ x.description) }};
{% endfor %}
{% for x in entities + relations if x.relation == 'table' and (x.defined|default(true)) and x.objects.consumer_view is defined %}
{% set source = x.objects.base_view if x.objects.base_view is defined else x.objects.table %}
REPLACE VIEW {{ x.objects.consumer_view|qualified }} AS
LOCKING ROW FOR ACCESS
SELECT {{ m.cols(x.columns|rejectattr('name', 'in', ('valid_to_dts', 'transaction_to_dts'))|map(attribute='physical_name')) }}
FROM {{ source|qualified }}
WHERE {{ m.current(x) }};
COMMENT ON VIEW {{ x.objects.consumer_view|qualified }} IS {{ m.comment('Current consumer surface: ' ~ x.description) }};
{% endfor %}
