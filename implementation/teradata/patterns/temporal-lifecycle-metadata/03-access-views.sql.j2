{# The governed base view of every persisted relation (this binding emits `base_view: all`):
   every column, every row, the full temporal contract. Then the consumer view: current rows
   only, without the open interval ends, which are always open on this surface. The consumer
   view selects the build context's `view_columns`, the same list Semantic registers as the
   view's AccessColumn rows, so the two cannot drift. Point-in-time reads go through the base
   view with the profile's predicates; Teradata SQL has no table functions. Runtime relations
   have no consumer view. Views read with an access lock so a consumer never blocks a load.
   Every view and every view column carries the comment of the table column beneath it. #}
{% import 'patterns/temporal-lifecycle-metadata/00-macros.sql.j2' as m with context %}
{% macro describe_columns(x, view, physical_names) -%}
{% for name in physical_names %}{% set col = x.columns|selectattr('physical_name', 'equalto', name)|first -%}
COMMENT ON COLUMN {{ view|qualified }}.{{ name|ident }} IS {{ m.comment(col.description or col.name) }};
{% endfor -%}
{%- endmacro %}
{% for x in entities + relations if x.relation == 'table' and (x.defined|default(true)) and x.objects.base_view is defined %}
{% set names = x.columns|map(attribute='physical_name')|list %}
REPLACE VIEW {{ x.objects.base_view|qualified }} ({{ m.cols(names) }}) AS
LOCKING ROW FOR ACCESS
SELECT {{ m.cols(names) }}
FROM {{ x.objects.table|qualified }};
COMMENT ON VIEW {{ x.objects.base_view|qualified }} IS {{ m.comment('Governed full contract: ' ~ x.description) }};
{{ describe_columns(x, x.objects.base_view, names) }}
{% endfor %}
{% for x in entities + relations if x.relation == 'table' and (x.defined|default(true)) and x.objects.consumer_view is defined %}
{% set source = x.objects.base_view if x.objects.base_view is defined else x.objects.table %}
{% set names = x.view_columns|map(attribute='physical_name')|list %}
REPLACE VIEW {{ x.objects.consumer_view|qualified }} ({{ m.cols(names) }}) AS
LOCKING ROW FOR ACCESS
SELECT {{ m.cols(names) }}
FROM {{ source|qualified }}
WHERE {{ m.current(x) }};
COMMENT ON VIEW {{ x.objects.consumer_view|qualified }} IS {{ m.comment('Current consumer surface: ' ~ x.description) }};
{{ describe_columns(x, x.objects.consumer_view, names) }}
{% endfor %}
