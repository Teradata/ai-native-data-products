{# One similarity function per `Embedding:` block (Search). Vectors come from the declared
   encoder outside the database; this binding never substitutes one. The function ranks the
   current vectors of its block by the declared similarity, keeps those at or above the
   declared threshold, and returns the embedded entity's identifier with the score. #}
{% for b in embeddings if b.objects.function is defined %}
{% set store = named(b.store) %}{% set sc = store.column_names %}{% set v = 'e.' ~ b.vector_column|ident %}
{% set score -%}
{%- if b.similarity == 'cosine' -%}
sum({{ v }}[i] * query_vector[i]) / nullif(sqrt(sum({{ v }}[i] ^ 2)) * sqrt(sum(query_vector[i] ^ 2)), 0)
{%- elif b.similarity == 'dot' -%}
sum({{ v }}[i] * query_vector[i])
{%- elif b.similarity == 'euclidean' -%}
1.0 / (1.0 + sqrt(sum(({{ v }}[i] - query_vector[i]) ^ 2)))
{%- else -%}
1.0 / (1.0 + sum(abs({{ v }}[i] - query_vector[i])))
{%- endif -%}
{%- endset %}
CREATE FUNCTION {{ b.objects.function|qualified }}(query_vector DOUBLE PRECISION[], result_limit INTEGER)
RETURNS TABLE(entity_id BIGINT, similarity DOUBLE PRECISION)
LANGUAGE SQL STABLE AS $body$
SELECT ranked.entity_id, ranked.similarity FROM (
    SELECT e.{{ sc.entity_id|ident }} AS entity_id,
           (SELECT {{ score }} FROM generate_series(1, {{ b.dimensions }}) g(i)) AS similarity
    FROM {{ store.objects.consumer_view|qualified }} e
    WHERE e.{{ sc.source_attribute|ident }} = {{ b.name|literal }}
{%- if b.model is defined and b.model %}
      AND e.{{ sc.embedding_model|ident }} = {{ b.model|literal }}
{%- endif %}
      AND cardinality(query_vector) = {{ b.dimensions }} AND array_ndims(query_vector) = 1
      AND array_position(query_vector, NULL) IS NULL
) ranked
{%- if b.threshold is defined and b.threshold %}
WHERE ranked.similarity >= {{ b.threshold }}
{%- endif %}
ORDER BY ranked.similarity DESC NULLS LAST, ranked.entity_id
LIMIT greatest(0, least(result_limit, 1000));
$body$;
COMMENT ON FUNCTION {{ b.objects.function|qualified }}(DOUBLE PRECISION[], INTEGER) IS {{ ('Similarity search over the ' ~ b.name ~ ' embedding of ' ~ b.entity ~ '. Takes a query vector and a result limit (maximum 1000).')|literal }};
{% endfor %}
