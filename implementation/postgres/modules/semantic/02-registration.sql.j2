{# The product's own description of itself (Semantic): registry, module map, entity, column and
   relationship catalogues, access objects, primary objects, the orientation sequence, metrics,
   synonyms and naming standards. Every row is read from the build context. #}
{% import 'patterns/temporal-lifecycle-metadata/00-macros.sql.j2' as m with context %}
{# The generated id of one key of an entity, found by the entity's identity and the key's name. #}
{% macro key_ref(keydef, meta, x, k) -%}
(SELECT d.{{ keydef.key_columns[0]|ident }} FROM {{ keydef.objects.table|qualified }} d
 WHERE d.{{ keydef.column_names.key_name|ident }} = {{ k.name|literal }}
   AND d.{{ keydef.column_names.entity_id|ident }} = {{ m.ref(meta, {'entity_name': x.logical_id}) }})
{%- endmacro %}
{% set registry = named('DataProductRegistry') %}{% set manifest = named('DataProductManifest') %}
{% if registry and manifest %}
{{ m.insert(registry, {
    'product_id': product.code, 'product_name': product.name,
    'product_description': product.description, 'product_domain': product.domain,
    'product_version': product.version, 'product_status': 'ACTIVE', 'owner_team': product.owner,
    'technical_contact': product.technical_contact|default(none),
    'trust_authoritative_producer': product.trust_producer,
    'approved_entrypoint': manifest.objects.consumer_view.container ~ '.' ~ manifest.objects.consumer_view.name,
    'approved_access_mode': orientation.access_mode|default('VIEW')}) }}
{% endif %}
{% set map = named('DataProductMap') %}
{% if map %}
{% for mc in module_containers if m.member(map, 'object_type', mc.role|upper) %}
{{ m.insert(map, {'module_name': mc.module|upper, 'object_type': mc.role|upper,
                  'container_name': mc.container, 'module_version': product.version,
                  'deployment_status': 'DEPLOYED'}) }}
{% endfor %}
{% endif %}
{% set declaration = named('StandardDeclaration') %}
{% if declaration %}
{% for d in standard.declarations %}
{{ m.insert(declaration, {'product_id': product.code, 'component_kind': d.kind, 'component_name': d.name,
                          'platform': standard.platform, 'standard_version': standard.version}) }}
{% endfor %}
{% endif %}
{% set meta = named('EntityMetadata') %}{% set colmeta = named('ColumnMetadata') %}
{% for x in entities + relations if x.objects.table is defined %}
{% set t = x.objects.table %}
{% if meta %}
{{ m.insert(meta, {
    'entity_name': x.logical_id, 'logical_name': x.name, 'entity_description': x.description,
    'entity_kind': x.kind|upper, 'module_name': x.module|upper, 'container_name': t.container,
    'table_name': t.name,
    'view_name': (x.objects.consumer_view.name if x.objects.consumer_view is defined else none),
    'temporal_pattern': x.profile,
    'current_flag_column': (x.column_names.is_current if x.history else none),
    'deleted_flag_column': (x.column_names.is_deleted if x.supports_deletion else none)}) }}
{% endif %}
{% set keydef = named('KeyDefinition') %}{% set keycol = named('KeyColumn') %}
{% if keydef and keycol and meta %}
{% for k in x.key_defs %}
{{ m.insert(keydef, {'key_role': k.role, 'key_name': k.name},
  {'entity_id': m.ref(meta, {'entity_name': x.logical_id})}) }}
{% for column in k.columns %}
{{ m.insert(keycol, {'ordinal': loop.index, 'column_name': column},
  {'key_definition_id': key_ref(keydef, meta, x, k)}) }}
{% endfor %}
{% endfor %}
{% endif %}
{% if colmeta %}
{% for col in x.columns %}
{{ m.insert(colmeta, {
    'container_name': t.container, 'table_name': t.name, 'column_name': col.physical_name,
    'logical_name': col.name, 'business_description': col.description or none,
    'is_pii': col.marker == 'pii',
    'sensitivity_marker': (col.marker|upper|replace('-', '_') if col.marker else none),
    'data_classification': col.classification, 'is_required': col.required,
    'declared_type': col.type, 'allowed_values': (col.members|tojson if col.members else none)}) }}
{% endfor %}
{% endif %}
{% endfor %}
{% set rel = named('TableRelationship') %}
{% if rel %}
{% set relcol = named('RelationshipColumn') %}
{% for r in relationships if r.source_table and r.target_table %}
{{ m.insert(rel, {
    'relationship_name': r.name, 'source_entity': r.source_identity, 'target_entity': r.target_identity,
    'relationship_type': 'FOREIGN_KEY', 'cardinality': 'MANY_TO_ONE', 'is_mandatory': r.mandatory}) }}
{% if relcol %}
{% for pair in r.pairs %}
{{ m.insert(relcol, {'ordinal': pair.ordinal, 'source_column': pair.source_column, 'target_column': pair.target_column},
  {'relationship_id': m.ref(rel, {'relationship_name': r.name})}) }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
{% set access = named('AccessObject') %}{% set acccol = named('AccessColumn') %}
{% set surface = {'table': 'base', 'base_view': 'governed', 'consumer_view': 'current', 'function': 'history', 'procedure': 'history'} %}
{% if access %}
{% for x in entities + relations %}
{% for role, obj in x.objects|dictsort if obj and m.member(access, 'object_type', role|upper) %}
{{ m.insert(access, {
    'object_identity': x.logical_id ~ ':' ~ surface[role], 'container_name': obj.container, 'object_name': obj.name,
    'object_type': role|upper,
    'access_role': ('BASE' if role in ('table', 'base_view') else 'PASSTHROUGH'),
    'represents_entity': x.logical_id,
    'is_agent_consumable': role in ('consumer_view', 'function'),
    'is_primary': role == 'consumer_view',
    'resolves_to_object': (x.logical_id ~ ':base' if role != 'table' and x.objects.table is defined else none),
    'access_note': x.description}) }}
{% if role == 'consumer_view' and acccol %}
{% for vc in x.view_columns %}
{{ m.insert(acccol, {'ordinal': vc.ordinal, 'column_name': vc.physical_name, 'source_entity': x.logical_id,
                     'source_column': vc.physical_name, 'mapping_kind': 'PASSTHROUGH'},
  {'access_object_id': m.ref(access, {'object_identity': x.logical_id ~ ':current'})}) }}
{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}
{% for b in embeddings %}
{% for role, obj in b.objects|dictsort if role in ('function', 'procedure') %}
{{ m.insert(access, {
    'object_identity': b.logical_id, 'container_name': obj.container, 'object_name': obj.name,
    'object_type': role|upper, 'access_role': 'PASSTHROUGH', 'represents_entity': none,
    'is_agent_consumable': true, 'is_primary': false,
    'access_note': 'Similarity search over the ' ~ b.name ~ ' embedding of ' ~ b.entity ~ '.'}) }}
{% endfor %}
{% endfor %}
{% endif %}
{% set primary = named('PrimaryObject') %}
{% if primary and map %}
{% for x in entities + relations %}
{% for role, obj in x.objects|dictsort if obj and obj.primary_role is defined %}
{{ m.insert(primary, {
    'container_name': obj.container, 'object_name': obj.name, 'object_type': role|upper,
    'object_role': obj.primary_role, 'usage_guidance': x.description},
  {'module_id': m.ref(map, {'module_name': x.module|upper, 'object_type': role|upper,
                            'container_name': obj.container})}) }}
{% endfor %}
{% endfor %}
{% endif %}
{% set orient = named('DataProductOrientation') %}
{% if orient and orientation %}
{% for res in orientation.resources %}
{{ m.insert(orient, {
    'product_id': product.code, 'resource_role': res.role, 'container_name': res.object.container,
    'object_name': res.object.name, 'is_required': res.required, 'discovery_order': res.order}) }}
{% endfor %}
{% endif %}
{% set metric = named('Metric') %}
{% if metric %}
{% for x in metrics %}
{{ m.insert(metric, {'metric_name': x.name, 'metric_description': x.description,
                     'metric_definition': x.measure.text}) }}
{% if x.measure.sql %}
{{ m.insert(named('MetricExpression'), {'sql_dialect': platform.name,
    'expression_text': x.measure.sql ~ ((' WHERE ' ~ x.filter.sql) if x.filter and x.filter.sql else '')},
  {'metric_name': m.ref(metric, {'metric_name': x.name})}) }}
{% endif %}
{% set ds = named(x.dataset) %}
{% if ds and ds.objects.consumer_view is defined %}
{{ m.insert(named('MetricDataset'), {'container_name': ds.objects.consumer_view.container,
    'table_name': ds.objects.consumer_view.name, 'dataset_role': 'PRIMARY'},
  {'metric_name': m.ref(metric, {'metric_name': x.name})}) }}
{% endif %}
{% endfor %}
{% endif %}
{% set syn = named('SemanticSynonym') %}
{% if syn and meta and colmeta %}
{% for x in entities if x.objects.table is defined %}
{% for s in x.synonyms|default([]) %}
{{ m.insert(syn, {'object_kind': 'ENTITYMETADATA', 'synonym_text': s},
  {'synonym_object': m.ref(meta, {'entity_name': x.logical_id})}) }}
{% endfor %}
{% for col in x.columns if col.synonyms %}
{% for s in col.synonyms %}
{{ m.insert(syn, {'object_kind': 'COLUMNMETADATA', 'synonym_text': s},
  {'synonym_object': m.ref(colmeta, {'container_name': x.objects.table.container,
                                     'table_name': x.objects.table.name, 'column_name': col.physical_name})}) }}
{% endfor %}
{% endfor %}
{% endfor %}
{% endif %}
{% set naming_rel = named('NamingStandard') %}
{% if naming_rel %}
{% for role, template in naming.objects|dictsort if m.member(naming_rel, 'applies_to', role.split(' ')[0]|upper) %}
{{ m.insert(naming_rel, {'standard_type': 'TEMPLATE', 'applies_to': role.split(' ')[0]|upper,
    'name_template': template, 'meaning': 'How the organisation names a ' ~ role ~ ' object.'}) }}
{% endfor %}
{{ m.insert(naming_rel, {'standard_type': 'TEMPLATE', 'applies_to': 'ATTRIBUTE',
    'name_template': naming.attributes, 'meaning': 'How the organisation names an attribute.'}) }}
{% for name, mapped in naming.standard_names|dictsort %}
{{ m.insert(naming_rel, {'standard_type': 'STANDARD_NAME', 'applies_to': 'ALL',
    'standard_value': name, 'mapped_value': mapped,
    'meaning': "The organisation's name for a standard-owned name."}) }}
{% endfor %}
{% endif %}
