{# The standard-owned discovery views (Design Specification Standard §4.1): Semantic's column
   catalogue, manifest and relationship paths, and Observability's lineage views. Each is
   created only where the composition places it, and reads only relations the build context
   places. #}
{% import 'patterns/temporal-lifecycle-metadata/00-macros.sql.j2' as m with context %}
{% set colmeta = named('ColumnMetadata') %}{% set catalogue = named('ColumnCatalogue') %}
{% if catalogue and colmeta %}{% set c = colmeta.column_names %}
CREATE VIEW {{ catalogue.objects.consumer_view|qualified }} AS
SELECT col.table_schema AS container_name, col.table_name, col.column_name, col.data_type,
       col.is_nullable, m.{{ c.logical_name|ident }} AS logical_name,
       m.{{ c.business_description|ident }} AS business_description, m.{{ c.is_pii|ident }} AS is_pii,
       m.{{ c.sensitivity_marker|ident }} AS sensitivity_marker,
       m.{{ c.data_classification|ident }} AS data_classification,
       m.{{ c.declared_type|ident }} AS declared_type,
       'information_schema.columns' AS structural_source,
       CASE WHEN m.{{ c.business_description|ident }} IS NULL THEN 'missing' ELSE 'authored' END AS description_source
FROM information_schema.columns col
LEFT JOIN {{ colmeta.objects.table|qualified }} m
  ON m.{{ c.container_name|ident }} = col.table_schema AND m.{{ c.table_name|ident }} = col.table_name
 AND m.{{ c.column_name|ident }} = col.column_name
WHERE {{ m.in_product('col.table_schema', 'col.table_name') }};
{% endif %}
{% set registry = named('DataProductRegistry') %}{% set orient = named('DataProductOrientation') %}
{% set manifest = named('DataProductManifest') %}
{% if manifest and registry and orient %}{% set p = registry.column_names %}{% set o = orient.column_names %}
CREATE VIEW {{ manifest.objects.consumer_view|qualified }} AS
SELECT r.{{ p.product_id|ident }} AS product_id, r.{{ p.product_name|ident }} AS product_name,
       r.{{ p.product_version|ident }} AS product_version, r.{{ p.product_status|ident }} AS product_status,
       r.{{ p.approved_entrypoint|ident }} AS approved_entrypoint,
       r.{{ p.approved_access_mode|ident }} AS approved_access_mode,
       r.{{ p.trust_authoritative_producer|ident }} AS trust_authoritative_producer
{%- for res in orientation.resources %},
       max(CASE WHEN o.{{ o.resource_role|ident }} = {{ res.role|literal }} THEN o.{{ o.container_name|ident }} || '.' || o.{{ o.object_name|ident }} END) AS {{ res.role|lower|ident }}
{%- endfor %}
FROM {{ registry.objects.table|qualified }} r
JOIN {{ orient.objects.table|qualified }} o ON o.{{ o.product_id|ident }} = r.{{ p.product_id|ident }}
WHERE r.{{ p.is_active|ident }} AND NOT r.{{ p.is_deleted|ident }} AND o.{{ o.is_active|ident }}
GROUP BY 1, 2, 3, 4, 5, 6, 7;
{% endif %}
{% set rel = named('TableRelationship') %}{% set paths = named('RelationshipPaths') %}
{% if paths and rel %}{% set t = rel.column_names %}
CREATE VIEW {{ paths.objects.consumer_view|qualified }} AS
WITH RECURSIVE edges AS (
    SELECT {{ t.source_container|ident }} || '.' || {{ t.source_table|ident }} AS from_object, {{ t.source_column|ident }} AS from_column,
           {{ t.target_container|ident }} || '.' || {{ t.target_table|ident }} AS to_object, {{ t.target_column|ident }} AS to_column
    FROM {{ rel.objects.table|qualified }} WHERE {{ t.is_active|ident }}
    UNION ALL
    SELECT {{ t.target_container|ident }} || '.' || {{ t.target_table|ident }}, {{ t.target_column|ident }},
           {{ t.source_container|ident }} || '.' || {{ t.source_table|ident }}, {{ t.source_column|ident }}
    FROM {{ rel.objects.table|qualified }} WHERE {{ t.is_active|ident }}
), paths AS (
    SELECT from_object, to_object, ARRAY[from_object, to_object] AS visited,
           from_object || '.' || from_column || ' = ' || to_object || '.' || to_column AS join_path, 1 AS hops
    FROM edges
    UNION ALL
    SELECT p.from_object, e.to_object, p.visited || e.to_object,
           p.join_path || ' AND ' || e.from_object || '.' || e.from_column || ' = ' || e.to_object || '.' || e.to_column,
           p.hops + 1
    FROM paths p JOIN edges e ON e.from_object = p.to_object
    WHERE p.hops < {{ paths.max_hops }} AND NOT e.to_object = ANY(p.visited)
)
SELECT from_object, to_object, join_path, hops FROM paths;
{% endif %}
{% set lineage = named('DataLineage') %}{% set graph_view = named('LineageGraph') %}
{% if graph_view and lineage %}{% set d = lineage.column_names %}
CREATE VIEW {{ graph_view.objects.consumer_view|qualified }} AS
SELECT DISTINCT coalesce({{ d.source_container|ident }} || '.', '') || coalesce({{ d.source_table|ident }}, {{ d.source_system|ident }}) AS source_node,
       {{ d.job_name|ident }} AS target_node, 'produces' AS edge_type
FROM {{ lineage.objects.table|qualified }} WHERE {{ d.is_active|ident }} AND {{ d.job_name|ident }} IS NOT NULL
UNION
SELECT DISTINCT {{ d.job_name|ident }}, coalesce({{ d.target_container|ident }} || '.', '') || {{ d.target_table|ident }}, 'produces'
FROM {{ lineage.objects.table|qualified }} WHERE {{ d.is_active|ident }} AND {{ d.job_name|ident }} IS NOT NULL;
{% endif %}
{% set run = named('LineageRun') %}{% set latest = named('LineageRunLatest') %}
{% if latest and lineage and run %}{% set d = lineage.column_names %}{% set r = run.column_names %}
CREATE VIEW {{ latest.objects.consumer_view|qualified }} AS
SELECT lineage_id, source_table, target_table, job_name, run_dts, run_status FROM (
    SELECT d.{{ d.lineage_id|ident }} AS lineage_id, d.{{ d.source_table|ident }} AS source_table,
           d.{{ d.target_table|ident }} AS target_table, d.{{ d.job_name|ident }} AS job_name,
           r.{{ r.run_dts|ident }} AS run_dts, r.{{ r.run_status|ident }} AS run_status,
           row_number() OVER (PARTITION BY d.{{ d.lineage_id|ident }}
                              ORDER BY r.{{ r.run_dts|ident }} DESC NULLS LAST, r.{{ r.lineage_run_id|ident }} DESC) AS rank
    FROM {{ lineage.objects.table|qualified }} d
    LEFT JOIN {{ run.objects.table|qualified }} r ON r.{{ r.lineage_id|ident }} = d.{{ d.lineage_id|ident }}
    WHERE d.{{ d.is_active|ident }}
) ranked WHERE rank = 1;
{% endif %}
