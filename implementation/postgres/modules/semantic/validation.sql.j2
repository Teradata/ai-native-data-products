{# Every table in a container the product places objects in is registered in EntityMetadata,
   keymaps included. Every returned row is an unregistered table. #}
{% set meta = named('EntityMetadata') %}{% set c = meta.column_names %}
SELECT t.table_schema, t.table_name FROM information_schema.tables t
LEFT JOIN {{ meta.objects.table|qualified }} e
  ON e.{{ c.container_name|ident }} = t.table_schema AND e.{{ c.table_name|ident }} = t.table_name
WHERE t.table_type = 'BASE TABLE'
  AND t.table_schema IN ({% for k in containers if k.holds_objects %}{{ k.name|literal }}{% if not loop.last %}, {% endif %}{% endfor %})
  AND e.{{ c.entity_name|ident }} IS NULL
