{# Caller-rendered, with: keymap (a Keymap entity from the build context) and natural_value.
   The caller opens the transaction. Allocation is permanent: a keymap row is never deleted
   or recycled. Returns the stable identifier. #}
{% set natural = keymap.identity.natural[0] %}{% set n = keymap.column_names[natural] %}
INSERT INTO {{ keymap.objects.table|qualified }} ({{ n|ident }}, {{ keymap.column_names.created_dts|ident }}, {{ keymap.column_names.updated_dts|ident }})
VALUES ({{ natural_value|literal }}, current_timestamp, current_timestamp)
ON CONFLICT ({{ n|ident }}) DO UPDATE SET {{ n|ident }} = excluded.{{ n|ident }}
RETURNING {{ keymap.key_columns[0]|ident }};
