{# The capture floor (Memory §5.2) per registered module: three design decisions, three
   glossary terms and one cookbook recipe, never met with generated filler. Every returned
   row is a module under its floor. #}
{% set reg = named('ModuleRegistry') %}{% set dd = named('DesignDecision') %}
{% set bg = named('BusinessGlossary') %}{% set qc = named('QueryCookbook') %}
SELECT r.{{ reg.column_names.module_name|ident }} FROM {{ reg.objects.consumer_view|qualified }} r WHERE
    (SELECT count(*) FROM {{ dd.objects.consumer_view|qualified }} d WHERE d.{{ dd.column_names.source_module|ident }} = r.{{ reg.column_names.module_name|ident }}) < 3
 OR (SELECT count(*) FROM {{ bg.objects.consumer_view|qualified }} g WHERE g.{{ bg.column_names.source_module|ident }} = r.{{ reg.column_names.module_name|ident }}) < 3
 OR NOT EXISTS (SELECT 1 FROM {{ qc.objects.consumer_view|qualified }} q WHERE q.{{ qc.column_names.source_module|ident }} = r.{{ reg.column_names.module_name|ident }})
