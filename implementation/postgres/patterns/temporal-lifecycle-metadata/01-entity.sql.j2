{# Generic physical entity binding. Business fields and identifiers come from entity inputs.
   Standard-owned metadata entities are declared alongside their module templates. #}
{% import 'patterns/temporal-lifecycle-metadata/00-temporal-macros.sql.j2' as tlm %}
{% macro table(e) -%}
{% if e.allocation=='keymap' %}
{% if platform=='duckdb' %}CREATE SEQUENCE {{ qualified(e.schema,e.keymap ~ '_seq') }};{% endif %}
CREATE TABLE {{ qualified(e.schema,e.keymap) }} (
 {{ e.key|ident }} BIGINT {% if platform=='postgres' %}GENERATED BY DEFAULT AS IDENTITY{% else %}DEFAULT nextval({{ (e.schema ~ '.' ~ e.keymap ~ '_seq')|literal }}){% endif %} PRIMARY KEY,
 {{ e.natural_key|ident }} VARCHAR NOT NULL UNIQUE,
 created_dts TIMESTAMPTZ NOT NULL DEFAULT current_timestamp,
 updated_dts TIMESTAMPTZ NOT NULL DEFAULT current_timestamp,
 UNIQUE ({{ e.key|ident }},{{ e.natural_key|ident }})
);
COMMENT ON TABLE {{ qualified(e.schema,e.keymap) }} IS 'Permanent natural-key allocation; identifiers must never be recycled.';
{% for name in [e.key,e.natural_key,'created_dts','updated_dts'] %}
COMMENT ON COLUMN {{ qualified(e.schema,e.keymap) }}.{{ name|ident }} IS {{ ('Permanent keymap field: ' ~ name)|literal }};
{% endfor %}
{% elif e.allocation=='inline' and platform=='duckdb' %}CREATE SEQUENCE {{ qualified(e.schema,e.name ~ '_seq') }};{% endif %}
CREATE TABLE {{ e.qualified }} (
{% for c in e.columns %}    {{ c.name|ident }} {{ c.type }}{% if c.name==e.key and e.allocation=='inline' %}{% if platform=='postgres' %} GENERATED BY DEFAULT AS IDENTITY{% else %} DEFAULT nextval({{ (e.schema ~ '.' ~ e.name ~ '_seq')|literal }}){% endif %}{% endif %}{% if not c.nullable %} NOT NULL{% endif %}{% if c.check %} CHECK({{ c.check }}){% endif %}{% if not loop.last %},{% endif %}
{% endfor %}{{ tlm.columns(e) }},
    PRIMARY KEY ({{ e.key|ident }}{% if e.history %},valid_from_dts{% endif %}{% if e.bitemporal %},transaction_from_dts{% endif %})
{{ tlm.constraints(e) }}
{% if e.allocation=='keymap' %}, FOREIGN KEY ({{ e.key|ident }},{{ e.natural_key|ident }}) REFERENCES {{ qualified(e.schema,e.keymap) }} ({{ e.key|ident }},{{ e.natural_key|ident }}){% endif %}
{% for constraint in e.constraints %}, {{ constraint }}{% endfor %}
);
{% if platform=='postgres' and e.history %}
CREATE UNIQUE INDEX ON {{ e.qualified }} ({{ e.key|ident }}) WHERE is_current;
ALTER TABLE {{ e.qualified }} ADD EXCLUDE USING gist
 ({{ e.key|ident }} WITH =,tstzrange(valid_from_dts,valid_to_dts,'[)') WITH &&{% if e.bitemporal %},tstzrange(transaction_from_dts,transaction_to_dts,'[)') WITH &&{% endif %});
{% endif %}
{%- endmacro %}
