{# The consumer view of every relation that has one: current rows only, with every column but
   the open interval ends, which are always open on this surface. A specification's
   expressions read the same columns through it as through the table. Then
   the point-in-time function of every versioned relation the binding emits one for. Runtime
   relations have no consumer view. #}
{% import 'patterns/temporal-lifecycle-metadata/00-macros.sql.j2' as m with context %}
{% for x in entities + relations if x.relation == 'table' and (x.defined|default(true)) and x.objects.consumer_view is defined %}
CREATE VIEW {{ x.objects.consumer_view|qualified }} AS
SELECT {{ m.cols(x.columns|rejectattr('name', 'in', ('valid_to_dts', 'transaction_to_dts'))|map(attribute='physical_name')) }}
FROM {{ x.objects.table|qualified }}
WHERE {{ m.current(x) }};
COMMENT ON VIEW {{ x.objects.consumer_view|qualified }} IS {{ ('Current consumer surface: ' ~ x.description)|literal }};
{% endfor %}
{% for x in entities + relations if x.relation == 'table' and (x.defined|default(true)) and x.objects.function is defined %}
CREATE FUNCTION {{ x.objects.function|qualified }}(valid_at TIMESTAMPTZ{% if x.bitemporal %}, known_at TIMESTAMPTZ{% endif %})
RETURNS SETOF {{ x.objects.table|qualified }} LANGUAGE SQL STABLE
SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $body$
SELECT * FROM {{ x.objects.table|qualified }} WHERE {{ m.at(x) }};
$body$;
{% endfor %}
