{# Rendered per relationship, with `relationship`. Current-surface referential coverage, not
   historical proof: every returned row is a current reference with no current target. A join of
   several columns resolves only when every pair matches. A generic reference is checked only for
   the rows its discriminator points at this target. #}
{% set r = relationship %}{% set source = named(r.source) %}
SELECT {% for p in r.pairs %}s.{{ p.source_column|ident }}{% if not loop.last %}, {% endif %}{% endfor %} FROM {{ (r.source_view or r.source_table)|qualified }} s
LEFT JOIN {{ (r.target_view or r.target_table)|qualified }} t ON {% for p in r.pairs %}s.{{ p.source_column|ident }} = t.{{ p.target_column|ident }}{% if not loop.last %} AND {% endif %}{% endfor %}
WHERE {% if r.discriminator %}s.{{ source.column_names[r.discriminator]|ident }} = {{ r.discriminator_value|literal }} AND {% endif %}{% if not r.mandatory %}{% for p in r.pairs %}s.{{ p.source_column|ident }} IS NOT NULL AND {% endfor %}{% endif %}t.{{ r.pairs[0].target_column|ident }} IS NULL
