{# Inputs: schemas. MetadataCoverageCheck, catalogue-wide: every row returned is an object or column with no comment.
   Sweeps the product's own schemas, so objects the declared entities do not mention are caught too.
   Objects owned by an extension (deptype 'e') are not the product's to document and are skipped. #}
SELECT n.nspname AS container_name,'schema' AS object_kind,n.nspname AS object_name,NULL::TEXT AS column_name
FROM pg_catalog.pg_namespace n
WHERE n.nspname IN ({% for schema in schemas %}{{ schema|literal }}{% if not loop.last %},{% endif %}{% endfor %})
 AND nullif(btrim(pg_catalog.obj_description(n.oid,'pg_namespace')),'') IS NULL
UNION ALL
SELECT n.nspname,CASE c.relkind WHEN 'v' THEN 'view' WHEN 'm' THEN 'materialized view' WHEN 'f' THEN 'foreign table' ELSE 'table' END,c.relname,NULL
FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
WHERE n.nspname IN ({% for schema in schemas %}{{ schema|literal }}{% if not loop.last %},{% endif %}{% endfor %})
 AND c.relkind IN ('r','p','v','m','f')
 AND NOT EXISTS (SELECT 1 FROM pg_catalog.pg_depend d WHERE d.classid='pg_catalog.pg_class'::regclass AND d.objid=c.oid AND d.deptype='e')
 AND nullif(btrim(pg_catalog.obj_description(c.oid,'pg_class')),'') IS NULL
UNION ALL
SELECT n.nspname,'column',c.relname,a.attname
FROM pg_catalog.pg_attribute a JOIN pg_catalog.pg_class c ON c.oid=a.attrelid JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
WHERE n.nspname IN ({% for schema in schemas %}{{ schema|literal }}{% if not loop.last %},{% endif %}{% endfor %})
 AND c.relkind IN ('r','p','v','m','f') AND a.attnum>0 AND NOT a.attisdropped
 AND NOT EXISTS (SELECT 1 FROM pg_catalog.pg_depend d WHERE d.classid='pg_catalog.pg_class'::regclass AND d.objid=c.oid AND d.deptype='e')
 AND nullif(btrim(pg_catalog.col_description(c.oid,a.attnum)),'') IS NULL
UNION ALL
SELECT n.nspname,'function',p.proname,NULL
FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace n ON n.oid=p.pronamespace
WHERE n.nspname IN ({% for schema in schemas %}{{ schema|literal }}{% if not loop.last %},{% endif %}{% endfor %})
 AND NOT EXISTS (SELECT 1 FROM pg_catalog.pg_depend d WHERE d.classid='pg_catalog.pg_proc'::regclass AND d.objid=p.oid AND d.deptype='e')
 AND nullif(btrim(pg_catalog.obj_description(p.oid,'pg_proc')),'') IS NULL
