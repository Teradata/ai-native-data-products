{# Rendered per persisted relation, with `entity`. Every returned row is a defect in the
   temporal profile's invariants: an empty interval, a current flag that disagrees with the
   open axes, overlapping versions of one identity, a tombstone without its instant, or a
   non-finite event timestamp. #}
{% set x = entity %}{% set cn = x.column_names %}{% set t = x.objects.table|qualified %}
{% set id = x.version_columns or x.key_columns %}
SELECT {% for k in id %}a.{{ k|ident }}{% if not loop.last %}, {% endif %}{% endfor %} FROM {{ t }} a WHERE FALSE
{%- if x.history %}
 OR a.{{ cn.valid_from_dts|ident }} >= a.{{ cn.valid_to_dts|ident }}
 OR a.{{ cn.is_current|ident }} <> (a.{{ cn.valid_to_dts|ident }} = 'infinity'::TIMESTAMPTZ{% if x.bitemporal %} AND a.{{ cn.transaction_to_dts|ident }} = 'infinity'::TIMESTAMPTZ{% endif %})
{%- if x.bitemporal %}
 OR a.{{ cn.transaction_from_dts|ident }} >= a.{{ cn.transaction_to_dts|ident }}
{%- endif %}
 OR EXISTS (SELECT 1 FROM {{ t }} b WHERE {% for k in id %}a.{{ k|ident }} = b.{{ k|ident }} AND {% endfor %}
     (a.{{ cn.valid_from_dts|ident }}{% if x.bitemporal %}, a.{{ cn.transaction_from_dts|ident }}{% endif %}) <> (b.{{ cn.valid_from_dts|ident }}{% if x.bitemporal %}, b.{{ cn.transaction_from_dts|ident }}{% endif %})
     AND a.{{ cn.valid_from_dts|ident }} < b.{{ cn.valid_to_dts|ident }} AND b.{{ cn.valid_from_dts|ident }} < a.{{ cn.valid_to_dts|ident }}
{%- if x.bitemporal %}
     AND a.{{ cn.transaction_from_dts|ident }} < b.{{ cn.transaction_to_dts|ident }} AND b.{{ cn.transaction_from_dts|ident }} < a.{{ cn.transaction_to_dts|ident }}
{%- endif %})
{%- endif %}
{%- if x.supports_deletion and 'deleted_dts' in cn %}
 OR a.{{ cn.is_deleted|ident }} <> (a.{{ cn.deleted_dts|ident }} IS NOT NULL)
{%- endif %}
{%- for col in x.columns if col.physical_type == 'TIMESTAMPTZ' and col.name not in ('valid_to_dts', 'transaction_to_dts') %}
 OR (a.{{ col.physical_name|ident }} IS NOT NULL AND NOT isfinite(a.{{ col.physical_name|ident }}))
{%- endfor %}
