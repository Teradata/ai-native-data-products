{# Inputs: containers.semantic, containers.observability. Requires both modules. #}
{% macro inherit_comments(source, target) %}
DO $copy$ DECLARE r RECORD; BEGIN
 FOR r IN SELECT a.attname AS col, pg_catalog.col_description(a.attrelid,a.attnum) AS txt FROM pg_catalog.pg_attribute a
  WHERE a.attrelid={{ source|literal }}::regclass AND a.attnum>0 AND NOT a.attisdropped
  AND EXISTS (SELECT 1 FROM pg_catalog.pg_attribute t WHERE t.attrelid={{ target|literal }}::regclass AND t.attname=a.attname AND NOT t.attisdropped)
 LOOP EXECUTE format('COMMENT ON COLUMN %s.%I IS %L',{{ target|literal }},r.col,r.txt); END LOOP;
END $copy$;
{% endmacro %}
{% macro trust_column_comments(view) %}
COMMENT ON COLUMN {{ view }}.product_prefix IS 'Data product the evidence describes.';
COMMENT ON COLUMN {{ view }}.producer_id IS 'Validation producer that supplied the evidence.';
COMMENT ON COLUMN {{ view }}.run_id IS 'Validation run that supplied the area evidence; null when none exists.';
COMMENT ON COLUMN {{ view }}.scope_kind IS 'Kind of scope the evidence covers, for example MODULE, ENTITY or PRODUCT.';
COMMENT ON COLUMN {{ view }}.scope_id IS 'Identifier of the scope the evidence covers.';
COMMENT ON COLUMN {{ view }}.area_status IS 'Outcome of the area: pass, fail, partial or no-evidence.';
COMMENT ON COLUMN {{ view }}.confidence IS 'Trust confidence for the area; unknown once the evidence has expired.';
COMMENT ON COLUMN {{ view }}.checks_expected IS 'Number of checks the area should have run.';
COMMENT ON COLUMN {{ view }}.checks_ran IS 'Number of checks the area actually ran.';
COMMENT ON COLUMN {{ view }}.passed_count IS 'Number of checks that passed.';
COMMENT ON COLUMN {{ view }}.failed_count IS 'Number of checks that failed.';
COMMENT ON COLUMN {{ view }}.error_count IS 'Number of checks that errored before producing a result.';
COMMENT ON COLUMN {{ view }}.critical_failure_count IS 'Number of failed checks of critical severity.';
COMMENT ON COLUMN {{ view }}.error_failure_count IS 'Number of failed or errored checks counted against trust.';
COMMENT ON COLUMN {{ view }}.coverage IS 'Fraction of expected checks that ran; null when none were expected.';
COMMENT ON COLUMN {{ view }}.open_gaps IS 'Known gaps in the evidence; states staleness when the evidence has expired.';
COMMENT ON COLUMN {{ view }}.recommended_action IS 'Next step to restore or confirm trust.';
COMMENT ON COLUMN {{ view }}.completed_dts IS 'When the area evidence was completed; null when none exists.';
{% endmacro %}
CREATE VIEW {{ containers.observability|ident }}.validation_run_latest AS
SELECT DISTINCT ON (product_prefix,producer_id) * FROM {{ containers.observability|ident }}.validation_run ORDER BY product_prefix,producer_id,completed_dts DESC,run_id DESC;
COMMENT ON VIEW {{ containers.observability|ident }}.validation_run_latest IS 'Latest validation run of each producer for each data product.';
{{ inherit_comments((containers.observability|ident)~'.validation_run',(containers.observability|ident)~'.validation_run_latest') }}

-- Authoritative producer and latest PER AREA; newer runs need not cover old areas.
-- No evidence remains visible, and stale evidence cannot retain strong confidence.
CREATE VIEW {{ containers.observability|ident }}.trust_map_evidence AS
WITH latest_area AS (
 SELECT DISTINCT ON (a.product_prefix,a.producer_id,a.scope_kind,a.scope_id) a.*,r.evidence_expires_dts FROM {{ containers.observability|ident }}.validation_area a
 JOIN {{ containers.observability|ident }}.validation_run r USING(product_prefix,producer_id,run_id)
 ORDER BY a.product_prefix,a.producer_id,a.scope_kind,a.scope_id,a.completed_dts DESC,a.run_id DESC
)
SELECT a.product_prefix,a.producer_id,a.run_id,a.scope_kind,a.scope_id,a.area_status,
 CASE WHEN current_timestamp > coalesce(a.evidence_expires_dts,
      a.completed_dts + p.max_evidence_age_days * INTERVAL '1 day') THEN 'unknown' ELSE a.confidence END AS confidence,
 a.checks_expected,a.checks_ran,a.passed_count,a.failed_count,a.error_count,
 a.critical_failure_count,a.error_failure_count,
 a.checks_ran::DOUBLE PRECISION/nullif(a.checks_expected,0) AS coverage,
 CASE WHEN current_timestamp > coalesce(a.evidence_expires_dts,a.completed_dts+p.max_evidence_age_days*INTERVAL '1 day')
      THEN 'Evidence is stale.' ELSE a.open_gaps END AS open_gaps,
 CASE WHEN current_timestamp > coalesce(a.evidence_expires_dts,a.completed_dts+p.max_evidence_age_days*INTERVAL '1 day')
      THEN 'Re-run the validator; disclose unknown confidence.' ELSE a.recommended_action END AS recommended_action,
 a.completed_dts
FROM latest_area a JOIN {{ containers.semantic|ident }}.data_product_registry p ON p.product_id=a.product_prefix
 AND (p.trust_authoritative_producer=a.producer_id OR nullif(p.trust_authoritative_producer,'') IS NULL)
UNION ALL
SELECT p.product_id,p.trust_authoritative_producer,NULL,'PRODUCT',p.product_id,'no-evidence','unknown',
       0,0,0,0,0,0,0,NULL,'No published area evidence.','Run the validator before reporting confidence.',NULL
FROM {{ containers.semantic|ident }}.data_product_registry p WHERE NOT EXISTS
 (SELECT 1 FROM latest_area a WHERE a.product_prefix=p.product_id
 AND (a.producer_id=p.trust_authoritative_producer OR nullif(p.trust_authoritative_producer,'') IS NULL));
COMMENT ON VIEW {{ containers.observability|ident }}.trust_map_evidence IS 'Latest evidence per producer and scope, with expiry applied and an explicit no-evidence row for products without any.';
{{ trust_column_comments(containers.observability|ident ~ '.trust_map_evidence') }}

CREATE VIEW {{ containers.observability|ident }}.trust_map AS
SELECT DISTINCT ON (e.product_prefix,e.scope_kind,e.scope_id) e.product_prefix,e.producer_id,e.run_id,e.scope_kind,e.scope_id,e.area_status,e.confidence,
       e.checks_expected,e.checks_ran,e.passed_count,e.failed_count,e.error_count,
       e.critical_failure_count,e.error_failure_count,e.coverage,e.open_gaps,
       CASE WHEN nullif(p.trust_authoritative_producer,'') IS NULL
            THEN 'No designated producer: cautious per-area fallback. '||coalesce(e.recommended_action,'Designate one producer.')
            ELSE e.recommended_action END AS recommended_action,e.completed_dts
FROM {{ containers.observability|ident }}.trust_map_evidence e JOIN {{ containers.semantic|ident }}.data_product_registry p ON p.product_id=e.product_prefix
ORDER BY e.product_prefix,e.scope_kind,e.scope_id,
 CASE e.confidence WHEN 'unknown' THEN 0 WHEN 'weak' THEN 1 WHEN 'partial' THEN 2 ELSE 3 END,
 e.completed_dts DESC,e.run_id DESC,e.producer_id;
COMMENT ON VIEW {{ containers.observability|ident }}.trust_map IS 'Trust map: the designated producer''s evidence for each scope, or the most cautious evidence when no producer is designated.';
{{ trust_column_comments(containers.observability|ident ~ '.trust_map') }}

CREATE VIEW {{ qualified(containers.access,"trust_map") }} AS SELECT * FROM {{ qualified(containers.observability,"trust_map") }};
COMMENT ON VIEW {{ qualified(containers.access,"trust_map") }} IS 'Consumer trust map: read this before relying on any other object in the data product.';
{{ trust_column_comments(qualified(containers.access,'trust_map')) }}
