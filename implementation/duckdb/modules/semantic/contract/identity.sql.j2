{# INV-SEMANTIC-016: identities follow the grammar and carry no placement. Every row is a defect. #}
{% import 'modules/semantic/contract/00-macros.sql.j2' as q %}
SELECT e.{{ q.col('EntityMetadata', 'entity_name') }}::TEXT AS identity, 'entity identity is not module.entity in its own module' AS defect
FROM {{ q.tbl('EntityMetadata') }} e
WHERE e.{{ q.col('EntityMetadata', 'is_active') }}
  AND (NOT regexp_matches(e.{{ q.col('EntityMetadata', 'entity_name') }}, '^[a-z][a-z0-9_]*[.][a-z][a-z0-9_]*$')
       OR e.{{ q.col('EntityMetadata', 'entity_name') }} NOT LIKE lower(e.{{ q.col('EntityMetadata', 'module_name') }}) || '.%')
UNION ALL
SELECT e.{{ q.col('EntityMetadata', 'entity_name') }}::TEXT, 'entity identity is registered more than once'
FROM {{ q.tbl('EntityMetadata') }} e
WHERE e.{{ q.col('EntityMetadata', 'is_active') }}
GROUP BY e.{{ q.col('EntityMetadata', 'entity_name') }}
HAVING count(*) > 1
UNION ALL
SELECT a.{{ q.col('AccessObject', 'object_identity') }}::TEXT, 'access identity breaks the grammar'
FROM {{ q.tbl('AccessObject') }} a
WHERE a.{{ q.col('AccessObject', 'is_active') }}
  AND NOT (regexp_matches(a.{{ q.col('AccessObject', 'object_identity') }}, '^[a-z][a-z0-9_]*[.][a-z][a-z0-9_]*:(base|governed|current|history)$')
        OR regexp_matches(a.{{ q.col('AccessObject', 'object_identity') }}, '^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$')
        OR regexp_matches(a.{{ q.col('AccessObject', 'object_identity') }}, '^composite:[a-z][a-z0-9_]*$'))
UNION ALL
SELECT a.{{ q.col('AccessObject', 'object_identity') }}::TEXT, 'single-entity identity does not match its entity and surface'
FROM {{ q.tbl('AccessObject') }} a
WHERE a.{{ q.col('AccessObject', 'is_active') }} AND a.{{ q.col('AccessObject', 'represents_entity') }} IS NOT NULL
  AND a.{{ q.col('AccessObject', 'object_identity') }} <> a.{{ q.col('AccessObject', 'represents_entity') }} || ':' ||
      CASE a.{{ q.col('AccessObject', 'object_type') }} WHEN 'TABLE' THEN 'base' WHEN 'BASE_VIEW' THEN 'governed'
           WHEN 'CONSUMER_VIEW' THEN 'current' ELSE 'history' END
