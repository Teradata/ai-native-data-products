{# Inputs: product, modules, containers, entities, relationships, declarations. No product-specific records.
   Identities are logical (module.entity); the physical location is registered beside them. #}
INSERT INTO {{ qualified(containers.semantic,'data_product_registry') }} VALUES
 ({{ product.id|literal }},{{ product.version|literal }},'ACTIVE',{{ product.owner|literal }},{{ product.validator|literal }},{{ product.entrypoint|literal }},'VIEW',{{ product.evidence_days }},current_timestamp,current_timestamp);
{% for kind,name in declarations %}
INSERT INTO {{ qualified(containers.semantic,'standard_declaration') }} VALUES
 ({{ (product.id ~ ':' ~ kind ~ ':' ~ name)|literal }},{{ product.id|literal }},{{ kind|literal }},{{ name|literal }},{{ platform|literal }},{{ standard_version|literal }},current_timestamp,current_timestamp);
{% endfor %}
{% for m in modules %}
INSERT INTO {{ qualified(containers.semantic,'data_product_map') }} VALUES
 ({{ m|literal }},{{ containers[m]|literal }},{{ ('Capabilities declared by the ' ~ m ~ ' module')|literal }},'DEPLOYED',{{ product.version|literal }},current_timestamp,current_timestamp);
{% endfor %}
{% for e in entities %}
INSERT INTO {{ qualified(containers.semantic,'entity_metadata') }} VALUES
 ({{ e.identity|literal }},{{ e.description|literal }},{{ e.module|literal }},{{ e.schema|literal }},{{ e.name|literal }},{{ (e.current_view if not e.runtime else none)|literal }},{{ e.profile|literal }},{{ ('is_current' if e.history else none)|literal }},{{ ('is_deleted' if e.supports_deletion else none)|literal }},NULL,current_timestamp,current_timestamp);
{% for k in e.key_defs %}
INSERT INTO {{ qualified(containers.semantic,'key_definition') }} VALUES
 ({{ k.id|literal }},{{ e.identity|literal }},{{ k.role|literal }},current_timestamp,current_timestamp);
{% for c in k.columns %}
INSERT INTO {{ qualified(containers.semantic,'key_column') }} VALUES
 ({{ (k.id ~ ':' ~ loop.index)|literal }},{{ k.id|literal }},{{ loop.index }},{{ c|literal }},current_timestamp,current_timestamp);
{% endfor %}
{% endfor %}
{% for c in e.all_columns %}
INSERT INTO {{ qualified(containers.semantic,'column_metadata') }} VALUES
 ({{ (e.identity ~ '.' ~ c.name)|literal }},{{ e.schema|literal }},{{ e.name|literal }},{{ c.name|literal }},{{ c.comment|literal }},{{ c.pii|literal }},{{ e.runtime|literal }},{{ c.classification|literal }},'Approved design',current_timestamp,current_timestamp);
{% endfor %}
INSERT INTO {{ qualified(containers.semantic,'access_object') }} VALUES
 ({{ (e.identity ~ ':base')|literal }},{{ e.schema|literal }},{{ e.name|literal }},'BASE',{{ e.identity|literal }},'One physical version or record',false,NULL,'Maintainer surface',current_timestamp,current_timestamp);
{% if not e.runtime %}
INSERT INTO {{ qualified(containers.semantic,'access_object') }} VALUES
 ({{ (e.identity ~ ':current')|literal }},{{ containers.access|literal }},{{ e.current_view|literal }},'PASSTHROUGH',{{ e.identity|literal }},'One current non-deleted record',true,{{ (e.identity ~ ':base')|literal }},'Declared consumer surface',current_timestamp,current_timestamp);
{% for c in e.access_columns %}
INSERT INTO {{ qualified(containers.semantic,'access_column') }} VALUES
 ({{ (e.identity ~ ':current:' ~ c.ordinal)|literal }},{{ (e.identity ~ ':current')|literal }},{{ c.ordinal }},{{ c.name|literal }},{{ e.identity|literal }},{{ c.source|literal }},'PASSTHROUGH',NULL,current_timestamp,current_timestamp);
{% endfor %}
INSERT INTO {{ qualified(containers.semantic,'primary_object') }} VALUES
 ({{ (e.identity ~ ':current')|literal }},{{ e.module|literal }},'VIEW','REFERENCE_LOOKUP',{{ e.description|literal }},current_timestamp,current_timestamp);
{% endif %}
{% endfor %}
{% for r in relationships %}
INSERT INTO {{ qualified(containers.semantic,'table_relationship') }} VALUES
 ({{ r.id|literal }},{{ r.source_entity.identity|literal }},{{ r.target_entity.identity|literal }},'MANY_TO_ONE','SEMANTIC',{{ r.mandatory|literal }},current_timestamp,current_timestamp);
{% for p in r.columns %}
INSERT INTO {{ qualified(containers.semantic,'relationship_column') }} VALUES
 ({{ (r.id ~ ':' ~ p.ordinal)|literal }},{{ r.id|literal }},{{ p.ordinal }},{{ p.source|literal }},{{ p.target|literal }},current_timestamp,current_timestamp);
{% endfor %}
{% endfor %}
{% for role,name in [('MANIFEST','data_product_manifest'),('MODULE_MAP','v_data_product_map'),('OBJECT_CATALOGUE','v_access_object'),('ENTITY_CATALOGUE','v_entity_metadata'),('COLUMN_CATALOGUE','column_catalogue'),('RELATIONSHIP_CATALOGUE','v_table_relationship')] %}
INSERT INTO {{ qualified(containers.semantic,'data_product_orientation') }} VALUES
 ({{ role|literal }},{{ product.id|literal }},{{ containers.access|literal }},{{ name|literal }},{{ loop.index+2 }},true,current_timestamp,current_timestamp);
{% endfor %}
{% if 'observability' in modules %}
INSERT INTO {{ qualified(containers.semantic,'data_product_orientation') }} VALUES
 ('TRUST_MAP',{{ product.id|literal }},{{ containers.access|literal }},'trust_map',2,true,current_timestamp,current_timestamp);
{% endif %}
