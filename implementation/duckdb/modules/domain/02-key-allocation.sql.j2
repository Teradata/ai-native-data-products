{# Caller-rendered, with keymap (a Keymap entity from the build context) and either:
   - natural_value, one value: inserted if new, its stable identifier returned; an existing
     mapping returns its identifier unchanged; or
   - staged, a set of values the caller has written to a table: {container (null for a
     temporary table), name, column}. One INSERT ... SELECT inserts every new value, NULLs
     and duplicates ignored, and the SELECT returns each staged value with its identifier.
   The caller opens the transaction on the single writing connection and retries a conflict.
   Allocation is permanent: a keymap row is never deleted or recycled. #}
{% set natural = keymap.identity.natural[0] %}{% set n = keymap.column_names[natural] %}{% set u = keymap.column_names.updated_dts %}
{% if staged is defined %}{% set source = staged|qualified if staged.container else staged.name|ident %}{% set v = staged.column|ident %}
{% set natural_type = (keymap.columns|selectattr('physical_name', 'equalto', n)|first).physical_type %}
INSERT INTO {{ keymap.objects.table|qualified }} ({{ n|ident }}, {{ keymap.column_names.created_dts|ident }}, {{ u|ident }})
SELECT DISTINCT CAST(s.{{ v }} AS {{ natural_type }}), current_timestamp, current_timestamp FROM {{ source }} AS s WHERE s.{{ v }} IS NOT NULL
ON CONFLICT ({{ n|ident }}) DO NOTHING;
SELECT k.{{ n|ident }}, k.{{ keymap.key_columns[0]|ident }} FROM {{ keymap.objects.table|qualified }} AS k WHERE k.{{ n|ident }} IN (SELECT s.{{ v }} FROM {{ source }} AS s);
{% else %}
INSERT INTO {{ keymap.objects.table|qualified }} AS k ({{ n|ident }}, {{ keymap.column_names.created_dts|ident }}, {{ u|ident }})
VALUES ({{ natural_value|literal }}, current_timestamp, current_timestamp)
ON CONFLICT ({{ n|ident }}) DO UPDATE SET {{ u|ident }} = k.{{ u|ident }}
RETURNING {{ keymap.key_columns[0]|ident }};
{% endif %}
