{# Inputs: entity (normalised keymap entity owner), natural_value.
Caller opens a transaction on the single writing connection and retries a transaction conflict.
Allocation is permanent; never delete/recycle a keymap row. An existing mapping returns its identifier
and leaves it unchanged. #}
INSERT INTO {{ qualified(entity.schema,entity.keymap) }} AS k ({{ entity.natural_key|ident }},created_dts,updated_dts)
VALUES ({{ natural_value|literal }},current_timestamp,current_timestamp)
ON CONFLICT ({{ entity.natural_key|ident }}) DO UPDATE SET updated_dts=k.updated_dts
RETURNING {{ entity.key|ident }};
