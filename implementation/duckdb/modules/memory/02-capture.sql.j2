{# Design memory (Memory §5.2): the records the build context settles, written as rows. Each
   cookbook recipe's query is rendered here, in this platform's dialect, from the metric,
   embedding, relationship or relation the recipe names. Nothing is invented: a record the
   context does not carry is not written. #}
{% import 'patterns/temporal-lifecycle-metadata/00-macros.sql.j2' as m with context %}

{% macro recipe_sql(r) -%}
{%- if r.kind == 'metric' -%}
{%- set x = (metrics|selectattr('name', 'equalto', r.metric)|first) -%}{%- set ds = named(x.dataset) -%}
SELECT {{ x.measure.sql }} AS {{ 'value'|ident }} FROM {{ ds.objects.consumer_view|qualified }} AS {{ ds.alias|ident }}
{%- if x.filter and x.filter.sql %} WHERE {{ x.filter.sql }}{% endif %}
{%- elif r.kind == 'similarity' -%}
{%- set b = (embeddings|selectattr('name', 'equalto', r.embedding)|first) -%}
{%- if r.join -%}{%- set d = named(b.entity) -%}
SELECT s.similarity, d.* FROM {{ b.objects.function|qualified }}($1, 10) s JOIN {{ d.objects.consumer_view|qualified }} d ON d.{{ d.key_columns[0]|ident }} = s.entity_id ORDER BY s.similarity DESC
{%- else -%}
SELECT * FROM {{ b.objects.function|qualified }}($1, 10)
{%- endif -%}
{%- elif r.kind == 'join' -%}
{%- set rel = relationships[r.relationship] -%}
SELECT s.*, t.* FROM {{ rel.source_view|qualified }} s JOIN {{ rel.target_view|qualified }} t ON s.{{ rel.source_column|ident }} = t.{{ rel.target_columns[0]|ident }}
{%- elif r.kind == 'catalogue' -%}
{%- set meta = named('EntityMetadata') -%}
SELECT * FROM {{ meta.objects.consumer_view|qualified }} WHERE {{ meta.column_names.module_name|ident }} IN ({% for mod in r.modules %}{{ (mod|upper)|literal }}{% if not loop.last %}, {% endif %}{% endfor %})
{%- else -%}
SELECT * FROM {{ named(r.relation).objects.consumer_view|qualified }}
{%- endif -%}
{%- endmacro %}

{% set registry = named('ModuleRegistry') %}
{% if registry %}
{% for mod in capture.modules %}
{{ m.insert(registry, {
    'module_name': mod.module|upper, 'container_name': mod.container, 'deployment_status': 'DEPLOYED',
    'module_version': product.version, 'module_purpose': mod.purpose,
    'key_entities': (mod.key_entities|join(', ') or none)}) }}
{% endfor %}
{% endif %}
{% set decision = named('DesignDecision') %}
{% if decision %}
{% for d in capture.decisions %}
{{ m.insert(decision, {
    'decision_id': d.decision_id, 'decision_version': 1, 'decision_title': d.title,
    'context': d.context, 'alternatives': d.alternatives, 'rationale': d.rationale,
    'decision_status': 'ACCEPTED', 'decision_category': d.category, 'source_module': d.module|upper}) }}
{% endfor %}
{% endif %}
{% set glossary = named('BusinessGlossary') %}
{% if glossary %}
{% for g in capture.glossary %}
{{ m.insert(glossary, {'term': g.term, 'term_category': g.category, 'definition': g.definition,
                       'source_module': g.module|upper}) }}
{% endfor %}
{% endif %}
{% set cookbook = named('QueryCookbook') %}
{% if cookbook %}
{% for r in capture.cookbook %}
{{ m.insert(cookbook, {
    'recipe_id': r.recipe_id, 'recipe_title': r.title, 'use_case': r.use_case,
    'target_module': r.target_module|upper, 'query_template': recipe_sql(r)|string,
    'complexity': r.complexity, 'is_batch': false, 'source_module': r.source_module|upper}) }}
{% endfor %}
{% endif %}
{% set notes = named('ImplementationNote') %}
{% if notes %}
{% for n in capture.notes %}
{{ m.insert(notes, {'note_id': n.note_id, 'note_title': n.title, 'note_content': n.content,
                    'note_category': n.category, 'severity': n.severity, 'source_module': n.module|upper}) }}
{% endfor %}
{% endif %}
{% set changes = named('ChangeLog') %}
{% if changes %}
{% for c in capture.change_log %}
{{ m.insert(changes, {'change_id': c.change_id, 'version_number': c.version, 'change_title': c.title,
                      'change_type': c.type, 'source_module': c.module|upper}) }}
{% endfor %}
{% endif %}
