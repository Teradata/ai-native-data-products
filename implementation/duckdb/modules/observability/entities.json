      {
        "name": "failed_count",
        "type": "INTEGER",
        "nullable": false,
        "comment": "Checks with FAILED status.",
        "check": "failed_count>=0"
      },
      {
        "name": "error_count",
        "type": "INTEGER",
        "nullable": false,
        "comment": "Checks that could not execute.",
        "check": "error_count>=0"
      },
      {
        "name": "critical_failure_count",
        "type": "INTEGER",
        "nullable": false,
        "comment": "Failed or errored CRITICAL checks.",
        "check": "critical_failure_count>=0"
      },
      {
        "name": "error_failure_count",
        "type": "INTEGER",
        "nullable": false,
        "comment": "Failed or errored ERROR-severity checks.",
        "check": "error_failure_count>=0"
      },
      {
        "name": "data_product_trust_score",
        "type": "INTEGER",
        "nullable": true,
        "comment": "Optional readiness score; null means unassessed.",
        "check": "data_product_trust_score BETWEEN 0 AND 100"
      },
      {
        "name": "performance_readiness_score",
        "type": "INTEGER",
        "nullable": true,
        "comment": "Optional readiness score; null means unassessed.",
        "check": "performance_readiness_score BETWEEN 0 AND 100"
      },
      {
        "name": "operational_readiness_score",
        "type": "INTEGER",
        "nullable": true,
        "comment": "Optional readiness score; null means unassessed.",
        "check": "operational_readiness_score BETWEEN 0 AND 100"
      },
      {
        "name": "repair_candidate_count",
        "type": "INTEGER",
        "nullable": false,
        "comment": "True repair proposal count."
      },
      {
        "name": "failed_checks_json",
