{# Inputs: schemas. MetadataCoverageCheck, catalogue-wide: every row returned is an object or column with no comment.
   Sweeps the product's own schemas, so objects the declared entities do not mention are caught too.
   DuckDB cannot comment a schema, so schemas are not swept. #}
SELECT 'table' AS object_kind,t.schema_name AS container_name,t.table_name AS object_name,CAST(NULL AS VARCHAR) AS column_name
FROM duckdb_tables() t
WHERE t.database_name=current_database() AND NOT t.internal
 AND t.schema_name IN ({% for schema in schemas %}{{ schema|literal }}{% if not loop.last %},{% endif %}{% endfor %})
 AND nullif(trim(t.comment),'') IS NULL
UNION ALL
SELECT 'view',v.schema_name,v.view_name,NULL
FROM duckdb_views() v
WHERE v.database_name=current_database() AND NOT v.internal
 AND v.schema_name IN ({% for schema in schemas %}{{ schema|literal }}{% if not loop.last %},{% endif %}{% endfor %})
 AND nullif(trim(v.comment),'') IS NULL
UNION ALL
SELECT 'column',c.schema_name,c.table_name,c.column_name
FROM duckdb_columns() c
WHERE c.database_name=current_database() AND NOT c.internal
 AND c.schema_name IN ({% for schema in schemas %}{{ schema|literal }}{% if not loop.last %},{% endif %}{% endfor %})
 AND nullif(trim(c.comment),'') IS NULL
UNION ALL
SELECT 'sequence',s.schema_name,s.sequence_name,NULL
FROM duckdb_sequences() s
WHERE s.database_name=current_database()
 AND s.schema_name IN ({% for schema in schemas %}{{ schema|literal }}{% if not loop.last %},{% endif %}{% endfor %})
 AND nullif(trim(s.comment),'') IS NULL
UNION ALL
SELECT 'macro',f.schema_name,f.function_name,NULL
FROM duckdb_functions() f
WHERE f.database_name=current_database() AND NOT f.internal AND f.function_type IN ('macro','table_macro')
 AND f.schema_name IN ({% for schema in schemas %}{{ schema|literal }}{% if not loop.last %},{% endif %}{% endfor %})
 AND nullif(trim(f.comment),'') IS NULL
